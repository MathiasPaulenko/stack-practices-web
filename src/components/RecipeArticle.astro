---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedResources from './RelatedResources.astro';
import CodeTabs from './CodeTabs.astro';
import Icon from './Icon.astro';
import type { RelatedItem } from './RelatedResources.astro';
import {
  techArticle,
  breadcrumbList,
  faqPage,
} from '../lib/schema';
import type { Locale } from '../config/site';

export interface Props {
  title: string;
  description: string;
  metaDescription: string;
  keywords: string[];
  difficulty: string;
  tags: string[];
  topics: string[];
  lastUpdated: Date;
  publishedAt?: Date;
  author: string;
  path: string;
  locale: Locale;
  listingHref: string;
  listingLabel: string;
  related: RelatedItem[];
  faqs: { question: string; answer: string }[];
  relatedLabel: string;
  contentType?: string;
}

const {
  title,
  description,
  metaDescription,
  keywords,
  difficulty,
  tags,
  topics,
  lastUpdated,
  publishedAt,
  author,
  path,
  locale,
  listingHref,
  listingLabel,
  related,
  faqs,
  relatedLabel,
  contentType,
} = Astro.props;

const localeTag = locale === 'es' ? 'es' : 'en';
const effectivePublishedAt = publishedAt || lastUpdated;
const dateModified = lastUpdated.toISOString();
const datePublished = effectivePublishedAt.toISOString();

const jsonLd: Record<string, unknown>[] = [
  techArticle({
    headline: title,
    description: metaDescription,
    url: path,
    locale: localeTag,
    datePublished,
    dateModified,
    difficulty,
    section: topics[0],
    keywords,
  }),

  breadcrumbList([
    { name: locale === 'es' ? 'Inicio' : 'Home', url: locale === 'es' ? '/es/' : '/' },
    { name: listingLabel, url: listingHref },
    { name: title, url: path },
  ]),
];

if (faqs.length > 0) {
  jsonLd.push(faqPage(faqs.slice(0, 3)));
}

const formattedDate = lastUpdated.toLocaleDateString(locale === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const dateLabel = `${locale === 'es' ? 'Última actualización' : 'Last updated'}: ${formattedDate}`;
---

<BaseLayout
  title={title}
  description={metaDescription}
  path={path}
  locale={locale}
  ogType="article"
  keywords={keywords}
  jsonLd={jsonLd}
>
  <div data-pagefind-filter={contentType ? `contentType[${contentType}]` : undefined}>
  <!-- Subtle brand accent line -->
  <div class="brand-accent"></div>

  <!-- Header section -->
  <header class="recipe-header">
    <div class="recipe-header__inner">
      <nav aria-label="Breadcrumb" class="recipe-breadcrumb">
        <a href={locale === 'es' ? '/es/' : '/'}>
          {locale === 'es' ? 'Inicio' : 'Home'}
        </a>
        <span class="recipe-breadcrumb__sep">/</span>
        <a href={listingHref}>{listingLabel}</a>
        <span class="recipe-breadcrumb__sep">/</span>
        <span class="recipe-breadcrumb__current">{title}</span>
      </nav>

      <div class="recipe-meta">
        <div class="recipe-meta__group">
          <span class={`difficulty-badge difficulty-badge--${difficulty}`}>
            <span class="recipe-meta__dot"></span>
            {difficulty}
          </span>
          <a href={`${locale === 'es' ? '/es' : ''}/authors/`} class="recipe-meta__author">
            {locale === 'es' ? 'Por' : 'By'} {author}
          </a>
          <time datetime={dateModified} class="recipe-meta__date">{dateLabel}</time>
        </div>
        <button
          type="button"
          onclick="window.print()"
          class="recipe-meta__print"
          aria-label={locale === 'es' ? 'Imprimir página' : 'Print page'}
        >
          <Icon name="printer" class="lucide lucide-printer" width="14" height="14" aria-hidden="true" />
          <span>{locale === 'es' ? 'Imprimir' : 'Print'}</span>
        </button>
      </div>

      <h1 class="recipe-title">{title}</h1>
      <p class="recipe-description">{description}</p>

      {
        tags.length > 0 && (
          <div class="recipe-tags">
            {tags.map((tag: string) => (
              <a
                href={`${locale === 'es' ? '/es' : ''}/tags/${tag}/`}
                class="recipe-tags__item"
              >
                {tag}
              </a>
            ))}
          </div>
        )
      }

      {
        topics.length > 0 && (
          <div class="recipe-topics">
            <span class="recipe-topics__label">{locale === 'es' ? 'Temas' : 'Topics'}:</span>
            {topics.map((topic: string) => (
              <a
                href={`${locale === 'es' ? '/es' : ''}/topics/${topic}/`}
                class="recipe-topics__item"
              >
                {topic.replace('-', ' ')}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </header>

  <!-- Table of Contents -->
  <nav id="toc-nav" class="toc-nav" style="display:none">
    <div class="toc-nav__inner">
      <details class="toc-nav__details">
        <summary class="toc-nav__summary">
          <span>{locale === 'es' ? 'Contenido' : 'Table of Contents'}</span>
          <Icon name="chevron-down" class="h-4 w-4 text-slate-400" aria-hidden="true" />
        </summary>
        <div id="toc-list" class="toc-nav__panel"></div>
      </details>
    </div>
  </nav>

  <!-- Locale-specific context to differentiate ES/EN and reduce duplicate content -->
  {
    locale === 'es' ? (
      <section class="bg-white">
        <div class="article-prose article-prose--top">
          <p class="locale-note locale-note--es">
            <strong>Nota para desarrolladores hispanohablantes:</strong> Esta guía incluye ejemplos y convenciones de nomenclatura adaptadas a equipos que trabajan en español. Cuando existen diferencias significativas en terminología técnica entre el inglés y el español, se indican explícitamente para facilitar la comunicación en equipos multiculturales.
          </p>
        </div>
      </section>
    ) : (
      <section class="bg-white">
        <div class="article-prose article-prose--top">
          <p class="locale-note">
            <strong>Note:</strong> This guide follows English-language naming conventions and terminology standards common in international development teams. Examples use English identifiers and comments to maximize compatibility across codebases and tooling.
          </p>
        </div>
      </section>
    )
  }

  <!-- Main content -->
  <section class="bg-white">
    <div class="article-prose article-prose--main">
      <slot />
    </div>
  </section>



  <!-- Related resources -->
  {
    related.length > 0 && (
      <section class="related-section">
        <div class="related-section__inner">
          <RelatedResources
            title={relatedLabel}
            items={related}
            locale={locale}
          />
        </div>
      </section>
    )
  }

  <!-- FAQ Section (visible, structured) -->
  {
    faqs.length > 0 && (
      <section class="faq-section">
        <div class="faq-section__inner">
          <h2 id="faq" class="faq-section__title">
            {locale === 'es' ? 'Preguntas frecuentes' : 'Frequently Asked Questions'}
          </h2>
          <dl class="faq-list">
            {faqs.slice(0, 10).map((faq: { question: string; answer: string }) => (
              <div class="faq-item">
                <dt class="faq-item__question">{faq.question}</dt>
                <dd class="faq-item__answer">{faq.answer}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }
  </div>
</BaseLayout>
