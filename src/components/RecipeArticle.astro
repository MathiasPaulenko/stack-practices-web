---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedResources from './RelatedResources.astro';
import CodeTabs from './CodeTabs.astro';
import type { RelatedItem } from './RelatedResources.astro';
import {
  techArticle,
  breadcrumbList,
  faqPage,
} from '../lib/schema';
import type { Locale } from '../config/site';

export interface Props {
  title: string;
  description: string;
  metaDescription: string;
  keywords: string[];
  difficulty: string;
  tags: string[];
  topics: string[];
  lastUpdated: Date;
  publishedAt?: Date;
  author: string;
  path: string;
  locale: Locale;
  listingHref: string;
  listingLabel: string;
  related: RelatedItem[];
  faqs: { question: string; answer: string }[];
  relatedLabel: string;
  contentType?: string;
}

const {
  title,
  description,
  metaDescription,
  keywords,
  difficulty,
  tags,
  topics,
  lastUpdated,
  publishedAt,
  author,
  path,
  locale,
  listingHref,
  listingLabel,
  related,
  faqs,
  relatedLabel,
  contentType,
} = Astro.props;

const localeTag = locale === 'es' ? 'es' : 'en';
const effectivePublishedAt = publishedAt || lastUpdated;
const dateModified = lastUpdated.toISOString();
const datePublished = effectivePublishedAt.toISOString();

const jsonLd: Record<string, unknown>[] = [
  techArticle({
    headline: title,
    description: metaDescription,
    url: path,
    locale: localeTag,
    datePublished,
    dateModified,
    difficulty,
    section: topics[0],
    keywords,
  }),

  breadcrumbList([
    { name: locale === 'es' ? 'Inicio' : 'Home', url: locale === 'es' ? '/es/' : '/' },
    { name: listingLabel, url: listingHref },
    { name: title, url: path },
  ]),
];

const lazyFaq = (contentType === 'recipes' || contentType === 'patterns') && faqs.length > 0;

if (faqs.length > 0 && !lazyFaq) {
  jsonLd.push(faqPage(faqs.slice(0, 3)));
}

const dateLabel = lastUpdated.toLocaleDateString(locale === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={metaDescription}
  path={path}
  locale={locale}
  ogType="article"
  keywords={keywords}
  jsonLd={jsonLd}
>
  <div data-pagefind-filter={contentType ? `contentType[${contentType}]` : undefined}>
  <!-- Subtle brand accent line -->
  <div class="h-[3px] bg-gradient-to-r from-brand-500 via-brand-400 to-transparent"></div>

  <!-- Header section -->
  <header class="recipe-header">
    <div class="recipe-header__inner">
      <nav aria-label="Breadcrumb" class="recipe-breadcrumb">
        <a href={locale === 'es' ? '/es/' : '/'}>
          {locale === 'es' ? 'Inicio' : 'Home'}
        </a>
        <span class="recipe-breadcrumb__sep">/</span>
        <a href={listingHref}>{listingLabel}</a>
        <span class="recipe-breadcrumb__sep">/</span>
        <span class="recipe-breadcrumb__current">{title}</span>
      </nav>

      <div class="recipe-meta">
        <div class="recipe-meta__group">
          <span class={`difficulty-badge difficulty-badge--${difficulty}`}>
            <span class="recipe-meta__dot"></span>
            {difficulty}
          </span>
          <a href={`${locale === 'es' ? '/es' : ''}/authors/`} class="recipe-meta__author">
            {locale === 'es' ? 'Por' : 'By'} {author}
          </a>
          <time datetime={dateModified} class="recipe-meta__date">{dateLabel}</time>
        </div>
        <button
          type="button"
          onclick="window.print()"
          class="recipe-meta__print"
          aria-label={locale === 'es' ? 'Imprimir página' : 'Print page'}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-printer"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
          <span>{locale === 'es' ? 'Imprimir' : 'Print'}</span>
        </button>
      </div>

      <h1 class="recipe-title">{title}</h1>
      <p class="recipe-description">{description}</p>

      {
        tags.length > 0 && (
          <div class="recipe-tags">
            {tags.map((tag: string) => (
              <a
                href={`${locale === 'es' ? '/es' : ''}/tags/${tag}/`}
                class="recipe-tags__item"
              >
                {tag}
              </a>
            ))}
          </div>
        )
      }

      {
        topics.length > 0 && (
          <div class="recipe-topics">
            <span class="recipe-topics__label">{locale === 'es' ? 'Temas' : 'Topics'}:</span>
            {topics.map((topic: string) => (
              <a
                href={`${locale === 'es' ? '/es' : ''}/topics/${topic}/`}
                class="recipe-topics__item"
              >
                {topic.replace('-', ' ')}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </header>

  <!-- Table of Contents -->
  <nav id="toc-nav" class="toc-nav" style="display:none">
    <div class="toc-nav__inner">
      <details class="toc-nav__details">
        <summary class="toc-nav__summary">
          <span>{locale === 'es' ? 'Contenido' : 'Table of Contents'}</span>
          <svg class="h-4 w-4 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div id="toc-list" class="toc-nav__panel"></div>
      </details>
    </div>
  </nav>

  <!-- Locale-specific context to differentiate ES/EN and reduce duplicate content -->
  {
    locale === 'es' ? (
      <section class="bg-white">
        <div class="prose prose-lg prose-slate mx-auto max-w-4xl px-4 pt-4 pb-2 prose-headings:scroll-mt-20 prose-a:text-brand-600 sm:px-6">
          <p class="locale-note locale-note--es">
            <strong>Nota para desarrolladores hispanohablantes:</strong> Esta guía incluye ejemplos y convenciones de nomenclatura adaptadas a equipos que trabajan en español. Cuando existen diferencias significativas en terminología técnica entre el inglés y el español, se indican explícitamente para facilitar la comunicación en equipos multiculturales.
          </p>
        </div>
      </section>
    ) : (
      <section class="bg-white">
        <div class="prose prose-lg prose-slate mx-auto max-w-4xl px-4 pt-4 pb-2 prose-headings:scroll-mt-20 prose-a:text-brand-600 sm:px-6">
          <p class="locale-note">
            <strong>Note:</strong> This guide follows English-language naming conventions and terminology standards common in international development teams. Examples use English identifiers and comments to maximize compatibility across codebases and tooling.
          </p>
        </div>
      </section>
    )
  }

  <!-- Main content -->
  <section class="bg-white">
    <div class="prose prose-lg prose-slate mx-auto max-w-4xl px-4 pt-4 pb-10 prose-headings:scroll-mt-20 prose-a:text-brand-600 prose-pre:rounded-lg sm:px-6">
      <slot />
    </div>
  </section>



  <!-- Related resources -->
  {
    related.length > 0 && (
      <section class="bg-slate-50">
        <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
          <RelatedResources
            title={relatedLabel}
            items={related}
            locale={locale}
          />
        </div>
      </section>
    )
  }

  {lazyFaq && faqs.length > 0 && (
    <script>
      window.__pageFaqs = JSON.parse(document.getElementById('page-faqs-data')?.textContent || '[]');
    </script>
  )}

  <script is:inline type="application/json" id="page-faqs-data">
    {JSON.stringify(faqs)}
  </script>

  <!-- FAQ Section (visible, structured) -->
  {
    faqs.length > 0 && !lazyFaq && (
      <section class="bg-white">
        <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
          <h2 id="faq" class="text-2xl font-bold text-slate-900">
            {locale === 'es' ? 'Preguntas frecuentes' : 'Frequently Asked Questions'}
          </h2>
          <dl class="mt-6 space-y-4">
            {faqs.map((faq: { question: string; answer: string }) => (
              <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                <dt class="font-semibold text-slate-900">{faq.question}</dt>
                <dd class="mt-2 text-slate-700">{faq.answer}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }
  </div>
</BaseLayout>
