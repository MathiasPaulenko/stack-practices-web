---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedResources from './RelatedResources.astro';
import CodeTabs from './CodeTabs.astro';
import type { RelatedItem } from './RelatedResources.astro';
import {
  techArticle,
  breadcrumbList,
  faqPage,
} from '../lib/schema';
import type { Locale } from '../config/site';

export interface Props {
  title: string;
  description: string;
  metaDescription: string;
  keywords: string[];
  difficulty: string;
  tags: string[];
  topics: string[];
  lastUpdated: Date;
  publishedAt?: Date;
  author: string;
  path: string;
  locale: Locale;
  listingHref: string;
  listingLabel: string;
  related: RelatedItem[];
  faqs: { question: string; answer: string }[];
  relatedLabel: string;
  contentType?: string;
}

const {
  title,
  description,
  metaDescription,
  keywords,
  difficulty,
  tags,
  topics,
  lastUpdated,
  publishedAt,
  author,
  path,
  locale,
  listingHref,
  listingLabel,
  related,
  faqs,
  relatedLabel,
  contentType,
} = Astro.props;

const localeTag = locale === 'es' ? 'es' : 'en';
const effectivePublishedAt = publishedAt || lastUpdated;
const dateModified = lastUpdated.toISOString();
const datePublished = effectivePublishedAt.toISOString();

const jsonLd: Record<string, unknown>[] = [
  techArticle({
    headline: title,
    description: metaDescription,
    url: path,
    locale: localeTag,
    datePublished,
    dateModified,
    difficulty,
    section: topics[0],
    keywords,
  }),

  breadcrumbList([
    { name: locale === 'es' ? 'Inicio' : 'Home', url: locale === 'es' ? '/es/' : '/' },
    { name: listingLabel, url: listingHref },
    { name: title, url: path },
  ]),
];

const lazyFaq = (contentType === 'recipes' || contentType === 'patterns') && faqs.length > 0;

if (faqs.length > 0 && !lazyFaq) {
  jsonLd.push(faqPage(faqs.slice(0, 3)));
}

const dateLabel = lastUpdated.toLocaleDateString(locale === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={metaDescription}
  path={path}
  locale={locale}
  ogType="article"
  keywords={keywords}
  jsonLd={jsonLd}
>
  <div data-pagefind-filter={contentType ? `contentType[${contentType}]` : undefined}>
  <!-- Subtle brand accent line -->
  <div class="h-[3px] bg-gradient-to-r from-brand-500 via-brand-400 to-transparent"></div>

  <!-- Header section -->
  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
        <a href={locale === 'es' ? '/es/' : '/'} class="font-medium text-brand-600 hover:text-brand-700 hover:underline">
          {locale === 'es' ? 'Inicio' : 'Home'}
        </a>
        <span class="mx-2 text-slate-400">/</span>
        <a href={listingHref} class="font-medium text-brand-600 hover:text-brand-700 hover:underline">{listingLabel}</a>
        <span class="mx-2 text-slate-400">/</span>
        <span class="font-medium text-slate-800">{title}</span>
      </nav>

      <div class="mt-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-green-200 bg-white px-2.5 py-0.5 text-xs font-medium capitalize text-green-700">
              <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
              {difficulty}
            </span>
            <span class="h-3 w-px bg-slate-300"></span>
            <a
              href={`${locale === 'es' ? '/es' : ''}/authors/`}
              class="text-xs font-medium text-brand-600 hover:text-brand-700 hover:underline"
            >
              {locale === 'es' ? 'Por' : 'By'} {author}
            </a>
            <span class="h-3 w-px bg-slate-300"></span>
            <time datetime={dateModified} class="text-xs font-medium text-slate-400">{dateLabel}</time>
          </div>
          <button
            type="button"
            onclick="window.print()"
            class="hidden rounded-md border border-slate-300 bg-white px-3 py-1 text-xs font-medium text-slate-600 hover:border-brand-400 hover:text-brand-700 sm:inline-flex sm:items-center sm:gap-1"
            aria-label={locale === 'es' ? 'Imprimir página' : 'Print page'}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-printer"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
            <span>{locale === 'es' ? 'Imprimir' : 'Print'}</span>
          </button>
        </div>

        <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{title}</h1>
        <p class="mt-2 text-lg text-slate-600">{description}</p>

        {
          tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag: string) => (
                <a
                  href={`${locale === 'es' ? '/es' : ''}/tags/${tag}/`}
                  class="rounded-full border border-slate-300 bg-white px-3 py-1 text-xs font-medium text-slate-600 transition hover:border-brand-400 hover:bg-brand-50 hover:text-brand-700"
                >
                  {tag}
                </a>
              ))}
            </div>
          )
        }

        {
          topics.length > 0 && (
            <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
              <span class="font-medium text-slate-400">{locale === 'es' ? 'Temas' : 'Topics'}:</span>
              {topics.map((topic: string) => (
                <a
                  href={`${locale === 'es' ? '/es' : ''}/topics/${topic}/`}
                  class="font-medium text-brand-600 hover:text-brand-700 hover:underline"
                >
                  {topic.replace('-', ' ')}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </header>

  <!-- Table of Contents -->
  <nav id="toc-nav" class="bg-white pt-6" style="display:none">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <details class="rounded-lg border border-slate-200 bg-white shadow-sm">
        <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-slate-800 select-none">
          <span>{locale === 'es' ? 'Contenido' : 'Table of Contents'}</span>
          <svg class="h-4 w-4 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div id="toc-list" class="border-t border-slate-100 px-4 py-2 text-sm"></div>
      </details>
    </div>
  </nav>

  <!-- Locale-specific context to differentiate ES/EN and reduce duplicate content -->
  {
    locale === 'es' ? (
      <section class="bg-white">
        <div class="prose prose-lg prose-slate mx-auto max-w-4xl px-4 pt-4 pb-2 prose-headings:scroll-mt-20 prose-a:text-brand-600 sm:px-6">
          <p class="rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-800">
            <strong>Nota para desarrolladores hispanohablantes:</strong> Esta guía incluye ejemplos y convenciones de nomenclatura adaptadas a equipos que trabajan en español. Cuando existen diferencias significativas en terminología técnica entre el inglés y el español, se indican explícitamente para facilitar la comunicación en equipos multiculturales.
          </p>
        </div>
      </section>
    ) : (
      <section class="bg-white">
        <div class="prose prose-lg prose-slate mx-auto max-w-4xl px-4 pt-4 pb-2 prose-headings:scroll-mt-20 prose-a:text-brand-600 sm:px-6">
          <p class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
            <strong>Note:</strong> This guide follows English-language naming conventions and terminology standards common in international development teams. Examples use English identifiers and comments to maximize compatibility across codebases and tooling.
          </p>
        </div>
      </section>
    )
  }

  <!-- Main content -->
  <section class="bg-white">
    <div class="prose prose-lg prose-slate mx-auto max-w-4xl px-4 pt-4 pb-10 prose-headings:scroll-mt-20 prose-a:text-brand-600 prose-pre:rounded-lg sm:px-6">
      <slot />
    </div>
  </section>



  <!-- Related resources -->
  {
    related.length > 0 && (
      <section class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
          <RelatedResources items={related} heading={relatedLabel} />
        </div>
      </section>
    )
  }

  <CodeTabs />


  </div>

  {lazyFaq && (
    <script is:inline define:vars={{ path, locale }}>
      (function(){var p=(locale==='es'?'/es':'')+path+'faq.json';fetch(p).then(function(r){return r.json();}).then(function(d){if(!d.faqSchema)return;var s=document.createElement('script');s.type='application/ld+json';s.textContent=JSON.stringify(d.faqSchema);document.head.appendChild(s);}).catch(function(){});})();
    </script>
  )}
</BaseLayout>
