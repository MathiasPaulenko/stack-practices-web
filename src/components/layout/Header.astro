---
import { SITE, MAIN_NAV, type Locale } from '../../config/site';

export interface Props {
  locale?: Locale;
}

const { locale = SITE.defaultLocale } = Astro.props;
const prefix = locale === 'es' ? '/es' : '';
const navPrefix = locale === 'es' ? '/es/' : '/';
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-slate-700 bg-slate-900/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={`${prefix}/`} class="flex items-center gap-2 font-bold text-white">
      <span class="grid h-12 w-12 shrink-0 place-items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="2 3 28 26" aria-hidden="true">
          <path d="M10 7C8.5 7 7.5 8 7.5 10v3c0 1.5-1 2.5-2.5 3 1.5.5 2.5 1.5 2.5 3v3c0 2 1 3 2.5 3" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M22 7c1.5 0 2.5 1 2.5 3v3c0 1.5 1 2.5 2.5 3-1.5.5-2.5 1.5-2.5 3v3c0 2-1 3-2.5 3" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="12" y="11" width="8" height="2" rx="1" fill="#fff" opacity="0.5"/>
          <rect x="11" y="15" width="10" height="2" rx="1" fill="#fff" opacity="0.75"/>
          <rect x="10" y="19" width="12" height="2" rx="1" fill="#fff"/>
        </svg>
      </span>
      <span class="text-xl">{SITE.name}</span>
    </a>

    <nav aria-label="Main navigation" class="hidden items-center gap-1 md:flex">
      {
        MAIN_NAV.map((item) => {
          const href = `${prefix}${item.href}`;
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                isActive
                  ? 'bg-brand-500/20 text-brand-300'
                  : 'text-slate-300 hover:bg-slate-800 hover:text-white',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="hamburger-button rounded-md p-2 text-slate-300 hover:bg-slate-800 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 md:hidden"
      aria-label={locale === 'es' ? 'Abrir menú de navegación' : 'Open navigation menu'}
      data-open-label={locale === 'es' ? 'Abrir menú de navegación' : 'Open navigation menu'}
      data-close-label={locale === 'es' ? 'Cerrar menú de navegación' : 'Close navigation menu'}
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="4" y1="6" x2="20" y2="6" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="18" x2="20" y2="18" />
      </svg>
    </button>

    <div class="flex items-center gap-2">
      <a
        href={`${prefix}/search/`}
        class="rounded-md p-2 text-slate-300 hover:bg-slate-800 hover:text-white"
        aria-label="Search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
      </a>
      <a
        href={locale === 'es' ? currentPath.replace(/^\/es/, '') || '/' : `/es${currentPath.endsWith('/') ? currentPath : `${currentPath}/`}`}
        class="rounded-md border border-slate-600 px-2.5 py-1.5 text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white"
        aria-label="Switch language"
      >
        {locale === 'es' ? 'EN' : 'ES'}
      </a>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="absolute inset-x-0 top-16 z-40 hidden border-b border-slate-700 bg-slate-900/95 p-4 shadow-lg backdrop-blur md:hidden"
    aria-label="Main navigation"
  >
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 sm:px-6">
      {
        MAIN_NAV.map((item) => {
          const href = `${prefix}${item.href}`;
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              class:list={[
                'rounded-md px-3 py-3 text-sm font-medium transition-colors',
                isActive
                  ? 'bg-brand-500/20 text-brand-300'
                  : 'text-slate-300 hover:bg-slate-800 hover:text-white',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    const toggle = document.getElementById('mobile-menu-toggle');
    const panel = document.getElementById('mobile-nav');
    if (!toggle || !panel) return;

    const focusables = () =>
      Array.from(
        panel.querySelectorAll('a[href], button, [tabindex]:not([tabindex="-1"])')
      ).filter((el) => !el.hasAttribute('disabled') && !el.hasAttribute('hidden'));

    function setOpen(open) {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open
        ? (toggle.dataset.closeLabel || 'Close navigation menu')
        : (toggle.dataset.openLabel || 'Open navigation menu'));
      if (open) {
        panel.classList.remove('hidden');
        const first = focusables()[0];
        if (first) first.focus();
      } else {
        panel.classList.add('hidden');
        toggle.focus();
      }
    }

    toggle.addEventListener('click', () => {
      setOpen(panel.classList.contains('hidden'));
    });

    panel.addEventListener('keydown', (e) => {
      const focusable = focusables();
      if (e.key === 'Tab' && focusable.length) {
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
      if (e.key === 'Escape') {
        setOpen(false);
      }
    });

    document.addEventListener('click', (e) => {
      if (
        !panel.classList.contains('hidden') &&
        !panel.contains(e.target) &&
        !toggle.contains(e.target)
      ) {
        setOpen(false);
      }
    });

    // Close when switching to desktop (matchMedia not strictly required on load,
    // but keeps panel hidden if user resizes above md).
    if (window.matchMedia) {
      const mql = window.matchMedia('(min-width: 768px)');
      mql.addEventListener('change', (e) => {
        if (e.matches) setOpen(false);
      });
    }
  })();
</script>
