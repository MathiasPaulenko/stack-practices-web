---
import { SITE, MAIN_NAV, type Locale } from '../../config/site';
import Icon from '../Icon.astro';

export interface Props {
  locale?: Locale;
}

const { locale = SITE.defaultLocale } = Astro.props;
const prefix = locale === 'es' ? '/es' : '';
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={`${prefix}/`} class="site-logo">
      <Icon name="logo" class="site-logo__mark" width="34" height="34" aria-hidden="true" />
      <span class="site-logo__name">{SITE.name}</span>
    </a>

    <nav aria-label="Main navigation" class="main-nav">
      {
        MAIN_NAV.map((item) => {
          const href = `${prefix}${item.href}`;
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              class:list={['main-nav__link', isActive && 'main-nav__link--active']}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="hamburger"
      aria-label={locale === 'es' ? 'Abrir menú de navegación' : 'Open navigation menu'}
      data-open-label={locale === 'es' ? 'Abrir menú de navegación' : 'Open navigation menu'}
      data-close-label={locale === 'es' ? 'Cerrar menú de navegación' : 'Close navigation menu'}
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <Icon name="menu" class="hamburger__icon" width="20" height="20" aria-hidden="true" />
    </button>

    <div class="header-actions">
      <a
        href={`${prefix}/search/`}
        class="header-actions__search"
        aria-label="Search"
      >
        <Icon name="search" class="header-actions__icon" width="20" height="20" aria-hidden="true" />
      </a>
      <a
        href={locale === 'es' ? currentPath.replace(/^\/es/, '') || '/' : `/es${currentPath.endsWith('/') ? currentPath : `${currentPath}/`}`}
        class="header-actions__lang"
        aria-label="Switch language"
      >
        {locale === 'es' ? 'EN' : 'ES'}
      </a>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="mobile-nav"
    aria-label="Main navigation"
  >
    <div class="mobile-nav__inner">
      {
        MAIN_NAV.map((item) => {
          const href = `${prefix}${item.href}`;
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              class:list={['mobile-nav__link', isActive && 'mobile-nav__link--active']}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>
  </nav>
</header>
