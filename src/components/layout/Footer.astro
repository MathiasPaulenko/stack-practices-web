---
import { SITE, FOOTER_NAV, type Locale } from '../../config/site';

export interface Props {
  locale?: Locale;
}

const { locale = SITE.defaultLocale } = Astro.props;
const prefix = locale === 'es' ? '/es' : '';
const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div>
        <a href={`${prefix}/`} class="site-footer__logo">
          <span class="site-footer__logo-mark">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M10 7C8.5 7 7.5 8 7.5 10v3c0 1.5-1 2.5-2.5 3 1.5.5 2.5 1.5 2.5 3v3c0 2 1 3 2.5 3" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M22 7c1.5 0 2.5 1 2.5 3v3c0 1.5 1 2.5 2.5 3-1.5.5-2.5 1.5-2.5 3v3c0 2-1 3-2.5 3" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="12" y="11" width="8" height="2" rx="1" fill="#fff" opacity="0.5"/>
              <rect x="11" y="15" width="10" height="2" rx="1" fill="#fff" opacity="0.75"/>
              <rect x="10" y="19" width="12" height="2" rx="1" fill="#fff"/>
            </svg>
          </span>
          <span>{SITE.name}</span>
        </a>
        <p class="site-footer__desc">
          {locale === 'es'
            ? 'Recetas de código, patrones de diseño y documentación de ingeniería de software.'
            : 'Practical code recipes, design patterns, and software engineering docs.'}
        </p>
        <a
          href="https://ko-fi.com/C6E4212B3X"
          target="_blank"
          rel="noopener noreferrer"
          class="site-footer__kofi"
          aria-label={locale === 'es' ? 'Apóyanos en Ko-fi' : 'Support us on Ko-fi'}
        >
          <img
            src="/kofi3.png"
            alt={locale === 'es' ? 'Apóyanos en ko-fi.com' : 'Buy Me a Coffee at ko-fi.com'}
            loading="lazy"
          />
        </a>
      </div>

      <div>
        <h2 class="site-footer__heading">Content</h2>
        <ul class="site-footer__list">
          {FOOTER_NAV.content.map((item) => (
            <li>
              <a href={`${prefix}${item.href}`}>{locale === 'es' ? item.labelEs : item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="site-footer__heading">Site</h2>
        <ul class="site-footer__list">
          {FOOTER_NAV.site.map((item) => (
            <li>
              <a href={`${prefix}${item.href}`}>{locale === 'es' ? item.labelEs : item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="site-footer__heading">Legal</h2>
        <ul class="site-footer__list">
          {FOOTER_NAV.legal.map((item) => (
            <li>
              <a href={`${prefix}${item.href}`}>{locale === 'es' ? item.labelEs : item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">
        &copy; {year} {SITE.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
