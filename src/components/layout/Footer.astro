---
import { SITE, FOOTER_NAV, type Locale } from '../../config/site';
import Icon from '../Icon.astro';

export interface Props {
  locale?: Locale;
}

const { locale = SITE.defaultLocale } = Astro.props;
const prefix = locale === 'es' ? '/es' : '';
const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div>
        <a href={`${prefix}/`} class="site-footer__logo">
          <span class="site-footer__logo-mark">
            <Icon name="logo" width="18" height="18" aria-hidden="true" />
          </span>
          <span>{SITE.name}</span>
        </a>
        <p class="site-footer__desc">
          {locale === 'es'
            ? 'Recetas de código, patrones de diseño y documentación de ingeniería de software.'
            : 'Practical code recipes, design patterns, and software engineering docs.'}
        </p>
        <a
          href="https://ko-fi.com/C6E4212B3X"
          target="_blank"
          rel="noopener noreferrer"
          class="site-footer__kofi"
          aria-label={locale === 'es' ? 'Apóyanos en Ko-fi' : 'Support us on Ko-fi'}
        >
          <img
            src="/kofi3.png"
            alt={locale === 'es' ? 'Apóyanos en ko-fi.com' : 'Buy Me a Coffee at ko-fi.com'}
            loading="lazy"
          />
        </a>
      </div>

      <div>
        <h2 class="site-footer__heading">Content</h2>
        <ul class="site-footer__list">
          {FOOTER_NAV.content.map((item) => (
            <li>
              <a href={`${prefix}${item.href}`}>{locale === 'es' ? item.labelEs : item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="site-footer__heading">Site</h2>
        <ul class="site-footer__list">
          {FOOTER_NAV.site.map((item) => (
            <li>
              <a href={`${prefix}${item.href}`}>{locale === 'es' ? item.labelEs : item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="site-footer__heading">Legal</h2>
        <ul class="site-footer__list">
          {FOOTER_NAV.legal.map((item) => (
            <li>
              <a href={`${prefix}${item.href}`}>{locale === 'es' ? item.labelEs : item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">
        &copy; {year} {SITE.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
