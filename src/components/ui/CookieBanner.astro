---
import type { Locale } from '../../config/site';

export interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const isEs = locale === 'es';
---

<div
  id="cookie-banner"
  class="cookie-banner"
  role="dialog"
  aria-label={isEs ? 'Consentimiento de cookies' : 'Cookie consent'}
>
  <div class="cookie-banner__inner">
    <div class="cookie-banner__row">
      <div class="cookie-banner__text">
        <p>
          {isEs
            ? 'StackPractices utiliza cookies esenciales, de análisis y publicidad. Puedes personalizar tus preferencias o aceptar todas. Consulta nuestra '
            : 'StackPractices uses essential, analytics, and advertising cookies. You can customize your preferences or accept all. See our '}
          <a href={`${isEs ? '/es' : ''}/cookies`}>
            {isEs ? 'Política de Cookies' : 'Cookie Policy'}
          </a>.
        </p>
      </div>
      <div class="cookie-banner__actions">
        <button id="cookie-reject" class="cookie-banner__btn">
          {isEs ? 'Rechazar' : 'Decline'}
        </button>
        <button id="cookie-manage" class="cookie-banner__btn">
          {isEs ? 'Gestionar' : 'Manage'}
        </button>
        <button id="cookie-accept" class="cookie-banner__btn--primary">
          {isEs ? 'Aceptar todo' : 'Accept All'}
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Consent Preferences Modal -->
<div
  id="cookie-modal"
  class="cookie-modal"
  role="dialog"
  aria-modal="true"
  aria-label={isEs ? 'Preferencias de cookies' : 'Cookie preferences'}
>
  <div class="cookie-modal__panel">
    <h2 class="cookie-modal__title">
      {isEs ? 'Preferencias de cookies' : 'Cookie Preferences'}
    </h2>
    <p class="cookie-modal__desc">
      {isEs
        ? 'Selecciona qué tipos de cookies aceptas. Las esenciales son necesarias para el funcionamiento del sitio.'
        : 'Select which types of cookies you accept. Essential cookies are required for the site to function.'}
    </p>

    <div class="cookie-modal__options">
      <!-- Essential -->
      <div class="cookie-modal__option">
        <div>
          <p class="cookie-modal__option-title">{isEs ? 'Esenciales' : 'Essential'}</p>
          <p class="cookie-modal__option-help">
            {isEs ? 'Necesarias para el funcionamiento del sitio.' : 'Required for the site to work.'}
          </p>
        </div>
        <input type="checkbox" checked disabled aria-label={isEs ? 'Cookies esenciales siempre activas' : 'Essential cookies always on'} class="cookie-modal__checkbox" />
      </div>

      <!-- Analytics -->
      <div class="cookie-modal__option">
        <div>
          <p class="cookie-modal__option-title">{isEs ? 'Análisis' : 'Analytics'}</p>
          <p class="cookie-modal__option-help">
            {isEs ? 'Ayudan a entender cómo se usa el sitio.' : 'Help us understand how the site is used.'}
          </p>
        </div>
        <input id="toggle-analytics" type="checkbox" aria-label={isEs ? 'Permitir cookies de análisis' : 'Allow analytics cookies'} class="cookie-modal__checkbox" />
      </div>

      <!-- Advertising -->
      <div class="cookie-modal__option">
        <div>
          <p class="cookie-modal__option-title">{isEs ? 'Publicidad' : 'Advertising'}</p>
          <p class="cookie-modal__option-help">
            {isEs ? 'Permiten mostrar anuncios relevantes.' : 'Allow us to show relevant ads.'}
          </p>
        </div>
        <input id="toggle-advertising" type="checkbox" aria-label={isEs ? 'Permitir cookies de publicidad' : 'Allow advertising cookies'} class="cookie-modal__checkbox" />
      </div>
    </div>

    <div class="cookie-modal__actions">
      <button id="modal-cancel" class="cookie-banner__btn">
        {isEs ? 'Cancelar' : 'Cancel'}
      </button>
      <button id="modal-save" class="cookie-banner__btn--primary">
        {isEs ? 'Guardar preferencias' : 'Save Preferences'}
      </button>
    </div>
  </div>
</div>
