---
export interface Props {
  title: string;
  description: string;
  href: string;
  difficulty?: string;
  tags?: string[];
  locale?: 'en' | 'es';
  /** Render a client-side search index attribute. Default true. */
  searchable?: boolean;
  style?: string;
}

const { title, description, href, difficulty, tags = [], locale = 'en', searchable = true, style } = Astro.props;

function smartTruncate(text: string, maxLength: number): string {
  if (text.length <= maxLength) return text;
  const truncated = text.slice(0, maxLength);
  const lastSpace = truncated.lastIndexOf(' ');
  return (lastSpace > 0 ? truncated.slice(0, lastSpace) : truncated) + '...';
}

const displayDescription = smartTruncate(description, 100);
const searchIndex = [title, displayDescription, difficulty, ...tags].filter(Boolean).join(' ').toLowerCase();
const tagPrefix = locale === 'es' ? '/es' : '';

const difficultyClass = difficulty ? `difficulty-badge difficulty-badge--${difficulty}` : '';
---

<div
  {...searchable ? { 'data-search': searchIndex } : {}}
  class="content-card"
  style={style}
>
  <div class="content-card__header">
    {
      difficulty && (
        <span class={difficultyClass}>
          {difficulty}
        </span>
      )
    }
  </div>
  <a href={href}>
    <h3 class="content-card__title">{title}</h3>
  </a>
  <p class="content-card__desc">{displayDescription}</p>
  {
    tags.length > 0 && (
      <div class="content-card__tags">
        {tags.slice(0, 4).map((tag: string) => (
          <a
            href={`${tagPrefix}/tags/${tag}/`}
            class="content-card__tag"
          >
            {tag}
          </a>
        ))}
      </div>
    )
  }
</div>
