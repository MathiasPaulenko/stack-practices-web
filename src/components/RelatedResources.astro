---
export interface RelatedItem {
  title: string;
  description: string;
  href: string;
  contentType: string;
}

export interface Props {
  items: RelatedItem[];
  heading?: string;
}

const { items, heading = 'Related Resources' } = Astro.props;

// Cap related resources to keep detail-page HTML size under control while
// still surfacing the most relevant cross-links.
const VISIBLE_ITEMS = 6;
const visibleItems = items.slice(0, VISIBLE_ITEMS);

const typeLabel: Record<string, string> = {
  recipes: 'Recipe',
  patterns: 'Pattern',
  docs: 'Doc',
  guides: 'Guide',
};
---

{
  items.length > 0 && (
    <div aria-labelledby="related-heading">
      <h2 id="related-heading" class="related-heading">{heading}</h2>
      <div class="related-grid">
        {visibleItems.map((item) => (
          <a href={item.href} class="related-card">
            <span class="related-card__type">
              {typeLabel[item.contentType] ?? item.contentType}
            </span>
            <h3 class="related-card__title">{item.title}</h3>
            <p class="related-card__desc">{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  )
}
