---
/**
 * Progressive-enhancement multi-language variant switcher.
 *
 * Scans a `.prose` container for consecutive H3 headings whose text is a known
 * programming language, each followed by a code block (<pre>), and groups them
 * into an accessible tablist. With JS disabled, all language sections remain
 * visible as normal headings + code — fully functional, just not tabbed.
 *
 * Include once per page that renders recipe/pattern markdown.
 */
---



<style is:global>
  .code-tabs {
    margin: 1.5rem 0;
    border: 1px solid var(--color-slate-200, #e2e8f0);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .code-tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.5rem 0.5rem 0;
    background: #1e293b;
  }
  .code-tabs__tab {
    padding: 0.4rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #cbd5e1;
    background: transparent;
    border: none;
    border-radius: 0.375rem 0.375rem 0 0;
    cursor: pointer;
  }
  .code-tabs__tab[aria-selected='true'] {
    color: #fff;
    background: #0f172a;
  }
  .code-tabs__tab:hover {
    color: #fff;
  }
  .code-tabs__panel > pre {
    margin: 0;
    border-radius: 0;
  }
</style>
