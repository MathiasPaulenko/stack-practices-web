---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from './ContentCard.astro';
import Icon from './Icon.astro';
import { collectionPage, breadcrumbList } from '../lib/schema';
import type { Locale } from '../config/site';
import { getPublicTagSet } from '../lib/content';

export interface ListingEntry {
  title: string;
  description: string;
  href: string;
  difficulty?: string;
  tags?: string[];
}

export interface Props {
  heading: string;
  description: string;
  path: string;
  entries: ListingEntry[];
  keywords?: string[];
  locale?: Locale;
  contentType?: string;
  hasAlternate?: boolean;
  jsonEndpoint?: string;
  initialLimit?: number;
  currentPage?: number;
}

const {
  heading,
  description,
  path,
  entries,
  keywords = [],
  locale = 'en',
  contentType,
  hasAlternate = true,
  jsonEndpoint,
  initialLimit = 20,
  currentPage = 1,
} = Astro.props;

const pageSize = initialLimit;
const totalPages = Math.ceil(entries.length / pageSize);
const pagedEntries = entries.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const isLazy = !!jsonEndpoint && entries.length > pageSize;
const showPagination = !isLazy && totalPages > 1;

const validTags = await getPublicTagSet(locale);

const basePath = currentPage > 1 ? path.replace(/\/\d+\/$/, '/') : path;
const pageTitle = currentPage > 1 ? `${heading} - Page ${currentPage}` : heading;

const homeHref = locale === 'es' ? '/es/' : '/';
const homeLabel = locale === 'es' ? 'Inicio' : 'Home';

const jsonLd = [
  collectionPage({
    name: heading,
    description,
    url: path,
    locale,
    items: pagedEntries.map((e: ListingEntry) => ({ name: e.title, url: e.href })),
  }),
  breadcrumbList([
    { name: homeLabel, url: homeHref },
    { name: heading, url: basePath },
  ]),
];

const emptyLabel = locale === 'es' ? 'No se encontraron resultados.' : 'No results found.';
const noContentLabel = locale === 'es' ? 'Aún no hay contenido publicado. Vuelve pronto.' : 'No content published yet. Check back soon.';

function pageHref(page: number) {
  return page === 1 ? basePath : `${basePath}${page}/`;
}

const pagesToShow = (() => {
  const pages: (number | string)[] = [];
  const delta = 2;
  for (let i = 1; i <= totalPages; i++) {
    if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) {
      pages.push(i);
    } else if (pages[pages.length - 1] !== '...') {
      pages.push('...');
    }
  }
  return pages;
})();
---

<BaseLayout title={pageTitle} description={description} path={path} locale={locale} keywords={keywords} jsonLd={jsonLd} hasAlternate={hasAlternate}>
  <div data-pagefind-filter={contentType ? `contentType[${contentType}]` : undefined}>
  <!-- Mini hero: breadcrumb, title, description, search -->
  <section class="listing-hero">
    <div class="listing-hero__inner">
      <nav aria-label="Breadcrumb" class="listing-hero__breadcrumb">
        <a href={homeHref} class="listing-hero__crumb">{homeLabel}</a>
        <span class="listing-hero__sep">/</span>
        <span class="listing-hero__current">{heading}</span>
      </nav>

      <h1 class="listing-hero__title">{heading}</h1>
      <p class="listing-hero__desc">{description}</p>

      {
        entries.length > 0 && (
          <div class="mt-6">
            <div class="listing-hero__search">
              <input
                type="text"
                id="listing-search"
                placeholder={locale === 'es' ? 'Buscar...' : 'Search...'}
                aria-label={locale === 'es' ? 'Buscar recursos' : 'Search resources'}
                class="listing-hero__input"
              />
              <Icon name="search" class="listing-hero__icon" aria-hidden="true" />
            </div>
            <p id="listing-count" class="listing-hero__count">
              {entries.length} {locale === 'es' ? 'resultados' : 'results'}
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- Intro slot -->
  <slot name="intro" />

  <!-- Card grid -->
  <section class="listing-body">
    <div class="listing-body__inner">
      {
        pagedEntries.length > 0 ? (
          <>
            <div id="listing-grid" class="listing-grid">
              {pagedEntries.map((entry: ListingEntry) => (
                <ContentCard
                  title={entry.title}
                  description={entry.description}
                  href={entry.href}
                  difficulty={entry.difficulty}
                  tags={entry.tags}
                  locale={locale}
                  validTags={validTags}
                />
              ))}
            </div>

            {isLazy && (
              <div class="listing-load-wrap">
                <button
                  id="load-more"
                  type="button"
                  data-endpoint={jsonEndpoint}
                  data-locale={locale}
                  data-total={entries.length}
                  data-limit={pageSize}
                  data-offset={pagedEntries.length}
                  class="load-more-btn"
                >
                  {locale === 'es' ? 'Cargar más' : 'Load more'}
                  <Icon name="chevron-down" class="h-4 w-4" aria-hidden="true" />
                </button>
              </div>
            )}

            {showPagination && (
              <nav class="listing-pagination" aria-label={locale === 'es' ? 'Paginación' : 'Pagination'}>
                {currentPage > 1 && (
                  <a href={pageHref(currentPage - 1)} class="listing-pagination__prev" aria-label={locale === 'es' ? 'Página anterior' : 'Previous page'}>
                    {locale === 'es' ? 'Anterior' : 'Prev'}
                  </a>
                )}

                <div class="listing-pagination__pages">
                  {pagesToShow.map((p) => (
                    p === '...' ? (
                      <span class="listing-pagination__ellipsis">…</span>
                    ) : p === currentPage ? (
                      <span class="listing-pagination__current" aria-current="page">{p}</span>
                    ) : (
                      <a href={pageHref(p as number)} class="listing-pagination__link">{p}</a>
                    )
                  ))}
                </div>

                {currentPage < totalPages && (
                  <a href={pageHref(currentPage + 1)} class="listing-pagination__next" aria-label={locale === 'es' ? 'Página siguiente' : 'Next page'}>
                    {locale === 'es' ? 'Siguiente' : 'Next'}
                  </a>
                )}
              </nav>
            )}

            <div id="listing-empty" class="listing-empty listing-empty--hidden">
              <p class="listing-empty__text">{emptyLabel}</p>
            </div>
          </>
        ) : (
          <div class="listing-empty">
            <p class="listing-empty__text">{noContentLabel}</p>
          </div>
        )
      }
    </div>
  </section>

  <script is:inline>
    (function () {
      const input = document.getElementById('listing-search');
      const grid = document.getElementById('listing-grid');
      const count = document.getElementById('listing-count');
      const empty = document.getElementById('listing-empty');
      const loadMoreBtn = document.getElementById('load-more');
      if (!input || !grid || !count || !empty) return;

      const isEs = count.textContent && count.textContent.includes('resultados');
      let allCards = () => Array.from(grid.querySelectorAll('[data-search]'));
      let loaded = !loadMoreBtn;
      let loading = false;

      function update() {
        const query = input.value.trim().toLowerCase();
        const terms = query.split(/\s+/).filter(Boolean);
        let visible = 0;

        allCards().forEach((card) => {
          const index = (card.getAttribute('data-search') || '').toLowerCase();
          const match = terms.every((term) => index.includes(term));
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });

        count.textContent = visible + ' ' + (isEs ? 'resultado' + (visible === 1 ? '' : 's') : 'result' + (visible === 1 ? '' : 's'));

        if (visible === 0) {
          grid.classList.add('hidden');
          empty.classList.remove('listing-empty--hidden');
        } else {
          grid.classList.remove('hidden');
          empty.classList.add('listing-empty--hidden');
        }
      }

      function createCard(entry) {
        const a = document.createElement('a');
        a.href = entry.href;
        a.setAttribute('data-search', (entry.title + ' ' + (entry.description || '') + ' ' + (entry.tags || []).join(' ')).toLowerCase());
        a.className = 'content-card';
        a.innerHTML = '<h3 class="content-card__title">' + entry.title + '</h3>' +
          (entry.difficulty ? '<div class="content-card__header"><span class="difficulty-badge difficulty-badge--' + entry.difficulty + '">' + entry.difficulty + '</span></div>' : '') +
          '<p class="content-card__desc">' + (entry.description || '') + '</p>';
        return a;
      }

      async function loadMore() {
        if (loading || !loadMoreBtn) return;
        loading = true;
        loadMoreBtn.disabled = true;
        loadMoreBtn.textContent = isEs ? 'Cargando...' : 'Loading...';

        try {
          const endpoint = loadMoreBtn.getAttribute('data-endpoint');
          const res = await fetch(endpoint);
          if (!res.ok) throw new Error('failed');
          const data = await res.json();
          const entries = data.entries || data.e || [];
          const existing = allCards().length;

          for (let i = existing; i < entries.length; i++) {
            grid.appendChild(createCard(entries[i]));
          }

          loaded = true;
          update();
          loadMoreBtn.style.display = 'none';
        } catch (e) {
          loadMoreBtn.textContent = isEs ? 'Error al cargar' : 'Error loading';
          loadMoreBtn.disabled = false;
          loading = false;
        }
      }

      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', loadMore);
      }

      input.addEventListener('input', () => {
        if (!loaded && input.value.trim().length > 0 && loadMoreBtn) {
          loadMore().then(update);
        } else {
          update();
        }
      });
    })();
  </script>
  </div>
</BaseLayout>
