---
import { SITE, type Locale } from '../config/site';

export interface Props {
  title: string;
  description: string;
  /** Path part after the locale, e.g. "/recipes/parse-json". Leading slash required. */
  path?: string;
  locale?: Locale;
  ogType?: 'website' | 'article';
  keywords?: string[];
  /** Whether a Spanish alternate exists for this page. */
  hasAlternate?: boolean;
  /** Optional JSON-LD objects to inject (already structured). */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Whether the canonical URL should end with a trailing slash. Default true. */
  trailingSlash?: boolean;
}

const {
  title,
  description,
  path = '/',
  locale = SITE.defaultLocale,
  ogType = 'website',
  keywords = [],
  hasAlternate = true,
  jsonLd = [],
  noindex = false,
  trailingSlash = true,
} = Astro.props;

function smartTruncate(text: string, maxLength: number): string {
  if (!text || text.length <= maxLength) return text;
  const end = text.lastIndexOf(' ', maxLength - 1);
  if (end === -1) return text.slice(0, maxLength - 1) + '…';
  return text.slice(0, end) + '…';
}

// Astro escapes & < > ' " in text content, so the rendered <title> is longer
// than the source string when it contains those characters. Count the extra
// characters &amp; (+4), &lt; (+3), &gt; (+3), &#39; (+4), &quot; (+5) so we
// can enforce the real SERP limit of 60 characters.
function htmlEscapedExtra(text: string): number {
  return (text.match(/&/g) || []).length * 4
    + (text.match(/</g) || []).length * 3
    + (text.match(/>/g) || []).length * 3
    + (text.match(/'/g) || []).length * 4
    + (text.match(/"/g) || []).length * 5;
}

const normalizedPath =
  path === '/'
    ? '/'
    : trailingSlash
      ? path.endsWith('/')
        ? path
        : `${path}/`
      : path.endsWith('/')
        ? path.slice(0, -1)
        : path;
const hasEsPrefix = normalizedPath.startsWith('/es/');
const enPath = hasEsPrefix ? normalizedPath.slice(3) : normalizedPath;
const esPath = hasEsPrefix ? normalizedPath : `/es${normalizedPath}`;
const enUrl = `${SITE.url}${enPath}`;
const esUrl = `${SITE.url}${esPath}`;
const canonical = locale === 'es' ? esUrl : enUrl;
const ogLocale = locale === 'es' ? 'es_ES' : 'en_US';

// Page-type labels disambiguate content that shares the same base title across
// recipes, guides, patterns, docs, topics, tags or authors.
const typeLabels: Record<string, { en: string; es: string }> = {
  recipes: { en: 'Recipe', es: 'Receta' },
  patterns: { en: 'Pattern', es: 'Patrón' },
  guides: { en: 'Guide', es: 'Guía' },
  docs: { en: 'Doc', es: 'Doc' },
  topics: { en: 'Topic', es: 'Tema' },
  tags: { en: 'Tag', es: 'Etiqueta' },
  authors: { en: 'Author', es: 'Autor' },
};

function pageTypeFromPath(p: string, loc: Locale): string | null {
  const segments = p.split('/').filter(Boolean);
  const first = segments[0] === 'es' ? segments[1] : segments[0];
  if (!first || !typeLabels[first]) return null;
  return typeLabels[first][loc];
}

const pageType = pageTypeFromPath(path, locale);

// Avoid redundant type labels when the title already starts with the type name
// (e.g. "Tag: ai" / "Etiqueta: ai").
const titleLower = title.toLowerCase().trim();
const typeLower = (pageType || '').toLowerCase();
const titleHasType = typeLower && (
  titleLower.startsWith(typeLower + ' ') ||
  titleLower.startsWith(typeLower + ':')
);
const effectiveType = titleHasType ? null : pageType;

const maxTitleLength = 60;

// Generic leading phrases and word+connector pairs that can be stripped from
// long titles to surface the unique, specific part before truncation.
const genericHeadPhrases = [
  'Complete Guide to ',
  'Service Level Objective (SLO) ',
  'Deep Clone de Objetos en ',
  'Deep Clone de Objetos ',
  'Deep Clone de ',
  'Deep Cloning of Objects ',
  'Deep Cloning ',
  'Building a ',
  'Building ',
  'Caching ',
  'Cache ',
  'Security Scan of ',
  'Configuring ',
  'Configure ',
  'Configurar ',
  'Comprimir y Descomprimir ',
  'Compress and Decompress ',
  'Compressing ',
  'Uploading ',
  'Upload ',
  'Validación de Subida de ',
  'Validacion de Subida de ',
  'Implementing ',
  'Implement ',
  'Orchestrating ',
  'Orchestrate ',
  'Construir un ',
  'Construir una ',
  'Construir ',
  'Cachear ',
  'Clonar ',
  'Implementar ',
  'Orquestar ',
  // Listing / tag / topic / author labels: their type is already shown by the
  // page-type suffix, so we can drop the explicit prefix when it saves space.
  'Etiqueta: ',
  'Tag: ',
  'Tema: ',
  'Topic: ',
  'Autor: ',
  'Author: ',
];

const genericHeadWords = new Set([
  'Plantilla', 'Template', 'Documento', 'Document', 'Política', 'Politica', 'Policy',
  'Checklist', 'Runbook', 'Playbook', 'Reporte', 'Report', 'Revisión', 'Revision', 'Review',
  'Evaluación', 'Evaluacion', 'Evaluation', 'Gestión', 'Gestion', 'Management',
  'Guía', 'Guia', 'Guide', 'Documentación', 'Documentacion', 'Documentation',
  'Línea', 'Linea', 'Line', 'Comunicación', 'Comunicacion', 'Communication',
  'Cronograma', 'Schedule', 'Auditoría', 'Auditoria', 'Audit', 'Informe',
  'Seguridad', 'Security', 'Acceso', 'Access', 'Subida', 'Reglas', 'Rules',
  'Clonación', 'Clonacion', 'Clone', 'Cloning', 'Tiempo', 'Escaneo',
]);

const genericConnectors = new Set([
  'de', 'of', 'to', 'for', 'a', 'an', 'un', 'una', 'el', 'la', 'los', 'las',
]);

// Only strip a generic prefix if the remainder still has enough substance to
// be a meaningful, unique title. We accept either two+ short words or a single
// long token (e.g. a hyphenated tag slug), but reject a single short word.
function hasEnoughWords(text: string): boolean {
  const words = text.trim().split(/\s+/).filter(Boolean);
  if (words.length >= 2) return text.trim().length >= 10;
  return text.trim().length >= 12;
}

function cleanGenericPrefix(rawTitle: string, available: number, depth = 0): string {
  if (depth > 4 || rawTitle.length <= available) return rawTitle;

  const lower = rawTitle.toLowerCase();
  for (const phrase of genericHeadPhrases) {
    if (lower.startsWith(phrase.toLowerCase())) {
      const next = rawTitle.slice(phrase.length).trim();
      if (next && hasEnoughWords(next)) return cleanGenericPrefix(next, available, depth + 1);
    }
  }

  const match = rawTitle.match(/^(\S+)\s+(\S+)\s*/);
  if (match) {
    const [, first, second] = match;
    if (genericHeadWords.has(first) && genericConnectors.has(second.toLowerCase())) {
      const next = rawTitle.slice(match[0].length).trim();
      if (next && hasEnoughWords(next)) return cleanGenericPrefix(next, available, depth + 1);
    }
  }

  return rawTitle;
}

// Build the brand suffix. We prefer the full " | Type | Site" suffix, but fall
// back to " | Site" and then to no suffix to keep the most important topic
// keywords in the <title> tag.
function buildBrandSuffix(): string {
  return effectiveType ? ` | ${effectiveType} | ${SITE.name}` : ` | ${SITE.name}`;
}

function buildShortBrandSuffix(): string {
  return ` | ${SITE.name}`;
}

function makeTitle(rawTitle: string): string {
  const extra = htmlEscapedExtra(rawTitle);
  // First, try the title without any brand suffix.
  if (rawTitle.length + extra <= maxTitleLength) {
    return rawTitle;
  }
  // If the title is too long on its own, truncate it so the unique topic
  // keywords are preserved at the start.
  return smartTruncate(rawTitle, maxTitleLength - extra);
}

function makeFullTitle(rawTitle: string, addBrand: boolean): string {
  if (!addBrand) {
    return makeTitle(rawTitle);
  }

  const extra = htmlEscapedExtra(rawTitle);
  const fullSuffix = buildBrandSuffix();
  const fullSuffixExtra = htmlEscapedExtra(fullSuffix);

  // Try the full title with the full brand suffix.
  if (rawTitle.length + extra + fullSuffix.length + fullSuffixExtra <= maxTitleLength) {
    return `${rawTitle}${fullSuffix}`;
  }

  // Try a shorter brand suffix.
  const shortSuffix = buildShortBrandSuffix();
  const shortSuffixExtra = htmlEscapedExtra(shortSuffix);
  if (rawTitle.length + extra + shortSuffix.length + shortSuffixExtra <= maxTitleLength) {
    return `${rawTitle}${shortSuffix}`;
  }

  // Fall back to the title alone (Google often appends the brand in SERP).
  if (rawTitle.length + extra <= maxTitleLength) {
    return rawTitle;
  }

  // Last resort: truncate the title to fit.
  const cleanTitle = cleanGenericPrefix(rawTitle, Math.max(20, maxTitleLength - extra));
  return smartTruncate(cleanTitle, maxTitleLength - extra);
}

function makeOgTitle(rawTitle: string, addBrand: boolean): string {
  if (!addBrand) return rawTitle;
  const shortSuffix = buildShortBrandSuffix();
  return `${rawTitle}${shortSuffix}`;
}

// Avoid a redundant brand suffix when the title already carries the site name
// (e.g. home pages).
const titleContainsBrand = title.toLowerCase().includes(SITE.name.toLowerCase());

const fullTitle = titleContainsBrand
  ? makeFullTitle(title, false)
  : makeFullTitle(title, true);

const ogTitle = titleContainsBrand
  ? makeOgTitle(title, false)
  : makeOgTitle(title, true);

const hasEn = locale === 'en' || hasAlternate;
const hasEs = locale === 'es' || hasAlternate;
const xDefault = hasEn ? enUrl : esUrl;

// Keep the meta description within the recommended length without locale tags.
const metaDescription = smartTruncate(description, 160);

// Escape non-ASCII characters and HTML-sensitive delimiters in JSON-LD so the
// inline <script type="application/ld+json"> is valid, pure ASCII, and safe to
// parse regardless of how the file is later inspected or transcoded.
function safeJsonStringify(obj: any): string {
  return JSON.stringify(obj)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/[\u0080-\uFFFF]/g, (ch: string) => {
      return '\\u' + ch.charCodeAt(0).toString(16).padStart(4, '0');
    });
}

---

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<meta name="author" content={SITE.author} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="canonical" href={canonical} />

{hasEn && <link rel="alternate" hreflang="en" href={enUrl} />}
{hasEs && <link rel="alternate" hreflang="es" href={esUrl} />}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={`${SITE.url}/og-image.png`} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={`${SITE.url}/og-image.png`} />
{SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}

<!-- JSON-LD structured data -->
{
  jsonLd.length > 0 && (
    <script
      is:inline
      type="application/ld+json"
      set:html={safeJsonStringify(
        jsonLd.length === 1
          ? jsonLd[0]
          : { '@context': 'https://schema.org', '@graph': jsonLd.map((s) => ({ ...s, '@context': undefined })) }
      )}
    />
  )
}
