---
import { getCollection } from 'astro:content';
import AuthorPage from '../../../components/AuthorPage.astro';
import { isSpanish } from '../../../lib/content';

export const prerender = true;

export async function getStaticPaths() {
  const PAGE_SIZE = 24;

  const allContent = await Promise.all([
    getCollection('recipes', ({ id, data }) => !isSpanish(id) && !data.draft),
    getCollection('patterns', ({ id, data }) => !isSpanish(id) && !data.draft),
    getCollection('docs', ({ id, data }) => !isSpanish(id) && !data.draft),
    getCollection('guides', ({ id, data }) => !isSpanish(id) && !data.draft),
  ]);

  const authorWorks = allContent.flat().map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    href: `/${entry.data.contentType}/${entry.data.slug}/`,
    difficulty: entry.data.difficulty,
    tags: entry.data.tags,
    date: entry.data.lastUpdated,
  })).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

  const totalPages = Math.ceil(authorWorks.length / PAGE_SIZE);

  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    const start = (page - 1) * PAGE_SIZE;
    const pageWorks = authorWorks.slice(start, start + PAGE_SIZE);
    return {
      params: { page: page.toString() },
      props: { page, totalPages, pageWorks },
    };
  });
}

const { page, totalPages, pageWorks } = Astro.props;
---

<AuthorPage locale="en" page={page} totalPages={totalPages} works={pageWorks} />
