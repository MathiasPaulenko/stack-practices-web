---
import { getCollection } from 'astro:content';
import AuthorPage from '../../../components/AuthorPage.astro';
import { isSpanish } from '../../../lib/content';

export const prerender = true;

const PAGE_SIZE = 24;

const allContent = await Promise.all([
  getCollection('recipes', ({ id, data }) => !isSpanish(id) && !data.draft),
  getCollection('patterns', ({ id, data }) => !isSpanish(id) && !data.draft),
  getCollection('docs', ({ id, data }) => !isSpanish(id) && !data.draft),
  getCollection('guides', ({ id, data }) => !isSpanish(id) && !data.draft),
]);

const authorWorks = allContent.flat().map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  href: `/${entry.data.contentType}/${entry.data.slug}/`,
  difficulty: entry.data.difficulty,
  tags: entry.data.tags,
  date: entry.data.lastUpdated,
})).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const totalPages = Math.ceil(authorWorks.length / PAGE_SIZE);
const pageWorks = authorWorks.slice(0, PAGE_SIZE);
---

<AuthorPage locale="en" page={1} totalPages={totalPages} works={pageWorks} />
