---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTENT_TYPES } from '../config/site';
import { webPage } from '../lib/schema';
import { getCollection } from 'astro:content';
import { isSpanish, buildTagIndex } from '../lib/content';

const [recipes, patterns, docs, guides] = await Promise.all([
  getCollection('recipes', ({ id }) => !isSpanish(id)),
  getCollection('patterns', ({ id }) => !isSpanish(id)),
  getCollection('docs', ({ id }) => !isSpanish(id)),
  getCollection('guides', ({ id }) => !isSpanish(id)),
]);

const recipesCount = recipes.length;
const patternsCount = patterns.length;
const docsCount = docs.length;
const guidesCount = guides.length;
const totalCount = recipesCount + patternsCount + docsCount + guidesCount;
const topics = new Set<string>();
for (const col of [recipes, patterns, docs, guides]) {
  for (const entry of col) {
    entry.data.topics.forEach((t: string) => topics.add(t));
  }
}
const topicsCount = topics.size;

const tagIndex = await buildTagIndex('en');
const popularTags = Array.from(tagIndex.entries())
  .map(([tag, items]) => ({ tag, count: items.length }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))
  .slice(0, 16);

const jsonLd = [
  webPage({
    name: SITE.title,
    description: SITE.description,
    url: '/',
    locale: 'en',
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${SITE.url}/search?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
];

const latestRecipes = [...recipes]
  .sort((a, b) => (b.data.lastUpdated?.getTime() || 0) - (a.data.lastUpdated?.getTime() || 0))
  .slice(0, 3);

const latestGuides = [...guides]
  .sort((a, b) => (b.data.lastUpdated?.getTime() || 0) - (a.data.lastUpdated?.getTime() || 0))
  .slice(0, 3);
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  path="/"
  ogType="website"
  keywords={['code recipes', 'design patterns', 'software engineering', 'developer documentation']}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="home-hero hero-animated-bg bg-slate-900">
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-code-symbol" aria-hidden="true">{ }</span>
    <span class="hero-code-symbol" aria-hidden="true">&lt;/&gt;</span>
    <span class="hero-code-symbol" aria-hidden="true">//</span>
    <span class="hero-code-symbol" aria-hidden="true">[ ]</span>
    <span class="hero-code-symbol" aria-hidden="true">&&</span>
    <span class="hero-code-symbol" aria-hidden="true">;;</span>
    <div class="home-hero__inner">
      <h1 class="home-hero__title">
        Practical software engineering knowledge, ready to reuse
      </h1>
      <p class="home-hero__desc">
        Find real-world code recipes, design patterns, and reusable documentation across
        Python, Java, JavaScript, SQL, and more.
      </p>
      <div class="home-hero__stats home-hero-stats">
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{totalCount}</div>
          <div class="home-hero-stat__label">Total</div>
        </div>
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{recipesCount}</div>
          <div class="home-hero-stat__label">Recipes</div>
        </div>
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{patternsCount}</div>
          <div class="home-hero-stat__label">Patterns</div>
        </div>
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{docsCount}</div>
          <div class="home-hero-stat__label">Docs</div>
        </div>
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{guidesCount}</div>
          <div class="home-hero-stat__label">Guides</div>
        </div>
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{topicsCount}</div>
          <div class="home-hero-stat__label">Topics</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Search -->
  <section class="home-search-section">
    <div class="home-search-inner">
      <form action="/search/" method="get" class="home-search-form">
        <svg class="home-search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input
          type="search"
          name="q"
          placeholder="Search recipes, patterns, docs, and guides..."
          aria-label="Search recipes, patterns, docs, and guides"
          class="home-search-input"
        />
        <button
          type="submit"
          class="home-search-btn"
        >
          Search
        </button>
      </form>
      <p class="home-search-hint">
        Try: <a href="/search/?q=python">python</a>,
        <a href="/search/?q=api">api</a>,
        <a href="/search/?q=docker">docker</a>,
        <a href="/search/?q=testing">testing</a>
      </p>
    </div>
  </section>

  <!-- Why StackPractices -->
  <section class="home-why-section">
    <div class="home-section__inner">
      <div class="home-why-header">
        <h2 class="home-why-header__title">Why StackPractices?</h2>
        <p class="home-why-header__desc">Built for developers who value speed, clarity, and reusable knowledge.</p>
      </div>
      <div class="home-why-grid">
        <div class="home-why-item">
          <span class="home-why-item__icon">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 12h6"/><path d="M12 9v6"/></svg>
          </span>
          <h3 class="home-why-item__title">Copy-paste ready</h3>
          <p class="home-why-item__desc">Code you can drop into your project and run immediately.</p>
        </div>
        <div class="home-why-item">
          <span class="home-why-item__icon">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h20"/><path d="M2 6h20"/><path d="M2 18h20"/></svg>
          </span>
          <h3 class="home-why-item__title">Multi-language</h3>
          <p class="home-why-item__desc">Examples in Python, Java, JavaScript, TypeScript, SQL, Bash, and more.</p>
        </div>
        <div class="home-why-item">
          <span class="home-why-item__icon">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
          <h3 class="home-why-item__title">Community driven</h3>
          <p class="home-why-item__desc">Open knowledge base shaped by real-world engineering challenges.</p>
        </div>
        <div class="home-why-item">
          <span class="home-why-item__icon">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
          </span>
          <h3 class="home-why-item__title">Structured docs</h3>
          <p class="home-why-item__desc">Consistent templates and guides for maintainable documentation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Browse by Type -->
  <section class="home-section home-section--white">
    <div class="home-section__inner">
      <h2 class="home-section__heading">Browse by type</h2>
      <p class="home-section__subheading">Choose the kind of resource you need for your project.</p>
      <div class="home-type-grid">
        {CONTENT_TYPES.map((type) => {
          const count = type.slug === 'recipes' ? recipesCount : type.slug === 'patterns' ? patternsCount : type.slug === 'docs' ? docsCount : guidesCount;
          const icon = type.slug === 'recipes' ? (
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2v2"/><path d="M15 2v2"/><path d="M12 2v8"/><path d="M8 4h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
          ) : type.slug === 'patterns' ? (
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
          ) : type.slug === 'docs' ? (
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/></svg>
          ) : (
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
          );
          return (
            <a href={`/${type.slug}/`} class="home-type-card">
              <div class="home-type-card__header">
                <span class="home-type-card__icon">{icon}</span>
                <div class="home-type-card__body">
                  <div class="home-type-card__title-row">
                    <h3 class="home-type-card__title">{type.label}</h3>
                    <span class="home-type-card__count">{count}</span>
                  </div>
                  <p class="home-type-card__desc">{type.description}</p>
                </div>
              </div>
              <div class="home-type-card__footer">
                Explore
                <svg class="ml-1.5 h-4 w-4 transition group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Browse by Tag -->
  <section class="home-section home-section--slate">
    <div class="home-section__inner">
      <div class="home-section__header">
        <div>
          <h2 class="home-section__heading">Browse by tag</h2>
          <p class="home-section__subheading">Quick access to the most popular topics across all content.</p>
        </div>
        <a href="/tags/" class="home-view-all">
          View all tags
          <svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="home-tag-cloud">
        {popularTags.map(({ tag, count }) => (
          <a href={`/tags/${tag}/`} class="home-tag-pill">
            <span class="home-tag-pill__count">{count}</span>
            {tag}
          </a>
        ))}
      </div>
      <a href="/tags/" class="home-view-all home-view-all--mobile">
        View all tags
        <svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <!-- Explore Topics CTA -->
  <section class="home-section home-section--white">
    <div class="home-section__inner">
      <div class="home-cta-box">
        <h2 class="home-cta-box__title">Explore by Topic & Technology</h2>
        <p class="home-cta-box__desc">
          Browse all resources organized by software engineering concepts like API Design,
          Authentication, and Testing — or by your favorite programming language.
        </p>
        <a href="/topics/" class="home-cta-btn">
          Browse topics
          <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Recipes -->
  <section class="home-section home-section--slate">
    <div class="home-section__inner">
      <div class="home-section__header">
        <div>
          <h2 class="home-section__heading">Latest recipes</h2>
          <p class="home-section__subheading">Fresh code solutions added to the knowledge base.</p>
        </div>
        <a href="/recipes/" class="home-view-all">
          View all
          <svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="home-content-grid">
        {latestRecipes.map((recipe) => (
          <a href={`/recipes/${recipe.data.slug}/`} class="home-content-card">
            <div class="home-content-card__meta">
              <span class="home-content-card__difficulty">{recipe.data.difficulty}</span>
              <span class="home-content-card__topic">{recipe.data.topics[0]?.replace(/-/g, ' ')}</span>
            </div>
            <h3 class="home-content-card__title">{recipe.data.title}</h3>
            <p class="home-content-card__desc">{recipe.data.description}</p>
            <div class="home-content-card__tags">
              {recipe.data.tags.slice(0, 3).map((tag: string) => (
                <span class="home-content-card__tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
      <a href="/recipes/" class="home-view-all home-view-all--mobile">View all recipes →</a>
    </div>
  </section>

  <!-- Latest Guides -->
  <section class="home-section home-section--white">
    <div class="home-section__inner">
      <div class="home-section__header">
        <div>
          <h2 class="home-section__heading">Latest guides</h2>
          <p class="home-section__subheading">In-depth engineering guides connecting recipes and patterns.</p>
        </div>
        <a href="/guides/" class="home-view-all">
          View all
          <svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="home-content-grid">
        {latestGuides.map((guide) => (
          <a href={`/guides/${guide.data.slug}/`} class="home-content-card">
            <div class="home-content-card__meta">
              <span class="home-content-card__difficulty">{guide.data.difficulty}</span>
              <span class="home-content-card__topic">{guide.data.topics[0]?.replace(/-/g, ' ')}</span>
            </div>
            <h3 class="home-content-card__title">{guide.data.title}</h3>
            <p class="home-content-card__desc">{guide.data.description}</p>
          </a>
        ))}
      </div>
      <a href="/guides/" class="home-view-all home-view-all--mobile">View all guides →</a>
    </div>
  </section>
</BaseLayout>
