---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { breadcrumbList, collectionPage } from '../../lib/schema';
import { TECHNOLOGIES } from '../../config/site';
import { getCollection } from 'astro:content';
import { isSpanish } from '../../lib/content';

const concepts = [
  { slug: 'data', icon: '\u{1F4CA}', desc: 'Data structures, parsing, serialization, and transformation.' },
  { slug: 'api', icon: '\u{1F50C}', desc: 'REST, GraphQL, and API design patterns for robust integrations.' },
  { slug: 'authentication', icon: '\u{1F512}', desc: 'JWT, OAuth, session management, and secure auth flows.' },
  { slug: 'file-handling', icon: '\u{1F4C1}', desc: 'Reading, writing, and manipulating files across languages.' },
  { slug: 'testing', icon: '\u{1F9EA}', desc: 'Unit, integration, and end-to-end testing strategies.' },
  { slug: 'architecture', icon: '\u{1F3D7}', desc: 'System design, microservices, and scalable patterns.' },
  { slug: 'design', icon: '\u{1F3A8}', desc: 'Software design principles, SOLID, and clean architecture.' },
  { slug: 'devops', icon: '\u{2699}', desc: 'CI/CD, containers, deployment, and infrastructure as code.' },
  { slug: 'databases', icon: '\u{1F5C4}', desc: 'SQL, NoSQL, ORMs, and data modeling techniques.' },
  { slug: 'ai', icon: '\u{1F916}', desc: 'LLMs, embeddings, vector search, and AI integration patterns.' },
  { slug: 'frontend', icon: '\u{1F4BB}', desc: 'Web performance, state management, accessibility, and UI patterns.' },
  { slug: 'infrastructure', icon: '\u{1F6E0}', desc: 'Cloud platforms, networking, load balancing, and service mesh.' },
  { slug: 'messaging', icon: '\u{1F4E8}', desc: 'Message queues, event buses, pub/sub, and stream processing.' },
  { slug: 'observability', icon: '\u{1F441}', desc: 'Metrics, logging, tracing, and monitoring for production systems.' },
  { slug: 'graphql', icon: '\u{1F310}', desc: 'GraphQL schemas, resolvers, federation, and API design.' },
  { slug: 'serverless', icon: '\u{2601}', desc: 'Functions, managed services, FaaS, and event-driven computing.' },
  { slug: 'caching', icon: '\u{26A1}', desc: 'In-memory stores, CDN caching, cache invalidation strategies.' },
  { slug: 'performance', icon: '\u{1F4C8}', desc: 'Profiling, optimization, and latency reduction techniques.' },
  { slug: 'security', icon: '\u{1F6E1}', desc: 'Encryption, vulnerability scanning, and secure coding practices.' },
  { slug: 'concurrency', icon: '\u{1F300}', desc: 'Async programming, threading, and parallel processing.' },
];


const [recipes, patterns, docs, guides] = await Promise.all([
  getCollection('recipes', e => !isSpanish(e.id)),
  getCollection('patterns', e => !isSpanish(e.id)),
  getCollection('docs', e => !isSpanish(e.id)),
  getCollection('guides', e => !isSpanish(e.id)),
]);

const allEntries = [...recipes, ...patterns, ...docs, ...guides];

function countByTopic(topic: string) {
  return allEntries.filter(e => e.data.topics.includes(topic as never)).length;
}

const jsonLd = [
  collectionPage({
    name: 'Topics',
    description: 'Browse StackPractices content by topic and technology.',
    url: '/topics',
    locale: 'en',
    items: concepts.map((c) => ({ name: c.slug, url: `/topics/${c.slug}/` })),
  }),
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Topics', url: '/topics/' },
  ]),
];
---

<BaseLayout
  title="Topics"
  description="Browse code recipes, patterns, docs, and guides by topic and technology."
  path="/topics/"
  keywords={['programming topics', 'technology topics', 'software engineering']}
  jsonLd={jsonLd}
  contentType="topic"
>
  <div class="brand-accent"></div>

  <header class="border-b border-slate-200 bg-slate-50">
    <div class="listing-container">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
        <a href="/" class="font-medium text-brand-600 hover:text-brand-700 hover:underline">Home</a>
        <span class="mx-2 text-slate-400">/</span>
        <span class="font-medium text-slate-800">Topics</span>
      </nav>
      <h1 class="mt-4 text-4xl font-bold text-slate-900">Topics</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-600">
        Browse our practical resources organized by software engineering concept or programming technology.
      </p>
    </div>
  </header>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900">Browse by Concept</h2>
      <p class="mt-2 text-slate-600">Explore content organized around core software engineering themes.</p>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {concepts.map((concept) => {
          const count = countByTopic(concept.slug);
          const s = concept.slug;
          const icon = s === 'data' ? (
            <Icon name="topic-data" class="h-5 w-5" aria-hidden="true" />
          ) : s === 'api' ? (
            <Icon name="topic-api" class="h-5 w-5" aria-hidden="true" />
          ) : s === 'authentication' ? (
            <Icon name="topic-authentication" class="h-5 w-5" aria-hidden="true" />
          ) : s === 'file-handling' ? (
            <Icon name="topic-file" class="h-5 w-5" aria-hidden="true" />
          ) : s === 'testing' ? (
            <Icon name="topic-testing" class="h-5 w-5" aria-hidden="true" />
          ) : s === 'architecture' ? (
            <Icon name="topic-architecture" class="h-5 w-5" aria-hidden="true" />
          ) : s === 'design' ? (
            <Icon name="topic-design" class="h-5 w-5" aria-hidden="true" />
          ) : s === 'devops' ? (
            <Icon name="topic-devops" class="h-5 w-5" aria-hidden="true" />
          ) : (
            <Icon name="topic-generic" class="h-5 w-5" aria-hidden="true" />
          );
          return (
            <a
              href={`/topics/${concept.slug}/`}
              class="group relative flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-brand-400 hover:shadow-lg"
            >
              <div class="flex items-start gap-4">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-slate-800 text-white">
                  {icon}
                </span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-2">
                    <h3 class="text-base font-semibold text-slate-900 capitalize group-hover:text-brand-600">
                      {concept.slug.replace(/-/g, ' ')}
                    </h3>
                    <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">
                      {count}
                    </span>
                  </div>
                  <p class="mt-1 text-sm leading-relaxed text-slate-500">{concept.desc}</p>
                </div>
              </div>
              <div class="mt-3 flex items-center text-sm font-medium text-brand-600">
                Explore
                <Icon name="chevron-right" class="ml-1.5 h-4 w-4 transition group-hover:translate-x-1" aria-hidden="true" />
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900">Browse by Technology</h2>
      <p class="mt-2 text-slate-600">Find resources for your preferred programming language or tool.</p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {TECHNOLOGIES.map((tech) => {
          const icon = tech === 'python' ? (
            <Icon name="tech-python" class="h-5 w-5" aria-hidden="true" />
          ) : tech === 'java' ? (
            <Icon name="tech-java" class="h-5 w-5" aria-hidden="true" />
          ) : tech === 'javascript' ? (
            <Icon name="tech-javascript" class="h-5 w-5" aria-hidden="true" />
          ) : tech === 'typescript' ? (
            <Icon name="tech-typescript" class="h-5 w-5" aria-hidden="true" />
          ) : tech === 'sql' ? (
            <Icon name="topic-generic" class="h-5 w-5" aria-hidden="true" />
          ) : tech === 'bash' ? (
            <Icon name="tech-bash" class="h-5 w-5" aria-hidden="true" />
          ) : tech === 'docker' ? (
            <Icon name="tech-docker" class="h-5 w-5" aria-hidden="true" />
          ) : tech === 'git' ? (
            <Icon name="tech-git" class="h-5 w-5" aria-hidden="true" />
          ) : (
            <Icon name="tech-generic" class="h-5 w-5" aria-hidden="true" />
          );
          return (
            <a
              href={`/tags/${tech}/`}
              class="group flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-400 hover:shadow-md"
            >
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-slate-800 text-white">
                {icon}
              </span>
              <div>
                <h3 class="text-base font-semibold capitalize text-slate-900 group-hover:text-brand-600">{tech}</h3>
                <p class="mt-0.5 text-xs text-slate-500">Code examples & guides</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
