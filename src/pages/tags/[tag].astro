---
import { buildTagIndex, MIN_TAG_RESOURCES } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { webPage, breadcrumbList } from '../../lib/schema';
import { tagIntros } from '../../data/tag-intros';

const PAGE_SIZE = 20;

export async function getStaticPaths() {
  const tagIndex = await buildTagIndex('en');
  return Array.from(tagIndex.entries())
    .filter(([, items]) => items.length >= MIN_TAG_RESOURCES)
    .map(([tag]) => ({
      params: { tag },
      props: { tag },
    }));
}

const { tag } = Astro.props;
const tagIndex = await buildTagIndex('en');
const items = tagIndex.get(tag) ?? [];
const esTagIndex = await buildTagIndex('es');
const hasEsVersion = esTagIndex.has(tag);

const heading = `Tag: ${tag}`;
const resourceCount = items.length;
const metaDescription = `Browse ${resourceCount} ${tag} resources — recipes, patterns, docs, and guides for production-ready software engineering.`;
const pageDescription = `Browse ${resourceCount} practical software engineering resources tagged with "${tag}". Discover code recipes, design patterns, documentation templates, and in-depth guides to help you build, deploy, and maintain production-ready solutions involving ${tag}. Each resource is written for engineers who ship real systems, with copy-paste examples and practical trade-offs.`;

const intro = tagIntros[tag]?.en;

const jsonLd = [
  webPage({ name: heading, description: metaDescription, url: `/tags/${tag}`, locale: 'en' }),
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Tags', url: '/tags/' },
    { name: tag, url: `/tags/${tag}/` },
  ]),
];

const initialItems = items.slice(0, PAGE_SIZE);
const hasMore = items.length > PAGE_SIZE;
---

<BaseLayout title={heading} description={metaDescription} path={`/tags/${tag}/`} keywords={[tag, 'tags', 'software engineering']} jsonLd={jsonLd} hasAlternate={hasEsVersion} noindex={items.length < 3}>
  <section class="border-b border-slate-800 bg-slate-900">
    <div class="listing-container">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-400">
        <a href="/" class="font-medium text-brand-400 hover:text-brand-300">Home</a>
        <span class="mx-2 text-slate-600">/</span>
        <a href="/tags/" class="font-medium text-brand-400 hover:text-brand-300">Tags</a>
        <span class="mx-2 text-slate-600">/</span>
        <span class="font-medium text-slate-300">{tag}</span>
      </nav>
      <h1 class="mt-4 text-3xl font-bold text-white">{heading}</h1>
      <p class="mt-2 max-w-2xl text-slate-300">{pageDescription}</p>
    </div>
  </section>

  {intro ? (
    <section class="listing-section">
      <div class="listing-container">
        <h2 class="listing-heading">{intro.heading}</h2>
        {intro.paragraphs.map((p) => (
          <p class="listing-intro">{p}</p>
        ))}
        <p class="listing-intro">
          Every resource includes clear explanations, copy-paste code, and practical warnings. Use them to make informed decisions, avoid production pitfalls, and speed up your delivery. If you are just getting started, read the beginner-friendly articles first; if you are experienced, jump straight to the advanced patterns and architecture guides. New resources are added regularly, so bookmark this page and check back for the latest patterns.
        </p>
      </div>
    </section>
  ) : (
    <section class="listing-section">
      <div class="listing-container">
        <h2 class="listing-heading">{tag} — Resources and Best Practices</h2>
        <p class="listing-intro">
          {tag} is a recurring theme across production software engineering. The resources below collect practical recipes, design patterns, documentation templates, and guides that show how to use {tag} effectively in real systems.
        </p>
        <p class="listing-intro">
          Each resource includes clear explanations, copy-paste code, and practical warnings. Use them to make informed decisions, avoid production pitfalls, and speed up your delivery. If you are just getting started, read the beginner-friendly articles first; if you are experienced, jump straight to the advanced patterns and architecture guides.
        </p>
        <p class="listing-intro">
          New resources are added regularly, so bookmark this page and check back for the latest patterns. You can also cross-reference related tags and topics to build a complete mental model before implementing {tag} in your own stack. Start with the simplest recipe and progress toward the architecture guide when you are ready to design larger systems.
        </p>
      </div>
    </section>
  )}

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      {
        items.length > 0 ? (
          <>
            <div id="tag-grid" class="listing-grid">
              {initialItems.map((item, i) => (
                <ContentCard
                  title={item.title}
                  description={item.description}
                  href={item.href}
                  tags={item.tags}
                  locale="en"
                  searchable={false}
                  showTags={false}
                  style={i >= PAGE_SIZE ? 'display:none' : undefined}
                />
              ))}
            </div>
            {hasMore && (
              <div class="mt-8 text-center">
                <button
                  id="load-more"
                  type="button"
                  class="load-more-btn"
                >
                  Load more
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </button>
              </div>
            )}
          </>
        ) : (
          <div class="rounded-xl border border-dashed border-slate-300 bg-slate-100 p-12 text-center">
            <p class="text-slate-600">No resources found with this tag.</p>
          </div>
        )
      }
    </div>
  </section>

  {hasMore && (
    <script is:inline define:vars={{ tag }}>
      (function () {
        const PAGE_SIZE = 20;
        const grid = document.getElementById('tag-grid');
        const loadMoreBtn = document.getElementById('load-more');
        if (!grid || !loadMoreBtn) return;

        function createCard(item) {
          const a = document.createElement('a');
          a.href = item.href;
          a.setAttribute('data-search', (item.title + ' ' + (item.description || '') + ' ' + (item.tags || []).join(' ')).toLowerCase());
          a.className = 'group flex h-full flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-400 hover:shadow-md';
          a.innerHTML = '<h3 class="text-lg font-semibold text-slate-900 group-hover:text-brand-600">' + item.title + '</h3>' +
            '<p class="mt-3 line-clamp-3 text-sm text-slate-600">' + (item.description || '') + '</p>';
          return a;
        }

        async function loadMore() {
          loadMoreBtn.disabled = true;
          loadMoreBtn.textContent = 'Loading...';

          try {
            const res = await fetch('/tags/' + encodeURIComponent(tag) + '.json');
            if (!res.ok) throw new Error('failed');
            const data = await res.json();
            const entries = data.entries || [];

            for (let i = PAGE_SIZE; i < entries.length; i++) {
              grid.appendChild(createCard(entries[i]));
            }

            loaded = true;
            loadMoreBtn.style.display = 'none';
          } catch (e) {
            loadMoreBtn.textContent = 'Error loading';
            loadMoreBtn.disabled = false;
          }
        }

        loadMoreBtn.addEventListener('click', loadMore);
      })();
    </script>
  )}
</BaseLayout>
