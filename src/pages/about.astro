---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { webPage, breadcrumbList, faqPage } from '../lib/schema';
import { PRIMARY_AUTHOR } from '../data/authors';

const jsonLd = [
  {
    ...webPage({
      name: 'About StackPractices',
      description: `Meet ${PRIMARY_AUTHOR.name}, the software engineer behind StackPractices. Discover copy-paste code recipes, design patterns, and engineering docs that help developers ship faster.`,
      url: '/about',
      locale: 'en',
    }),
    datePublished: '2026-06-10',
  },
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about' },
  ]),
  faqPage([
    { question: 'What is StackPractices?', answer: 'StackPractices is a practical developer knowledge base offering copy-paste code recipes, design patterns, and documentation templates for software engineers across Python, Java, JavaScript, SQL, and more.' },
    { question: 'Who runs StackPractices?', answer: `StackPractices is curated by ${PRIMARY_AUTHOR.name}, a ${PRIMARY_AUTHOR.jobTitle} with 12+ years of experience building production systems across Python, JavaScript, React, and DevOps.` },
    { question: 'Is the content free?', answer: 'Yes. All content is free to use. No paywalls, no subscriptions. The project is sustained through advertising, affiliate partnerships, and community donations.' },
    { question: 'What languages are covered?', answer: 'Content is published in English and Spanish. Code examples cover Python, Java, JavaScript, TypeScript, SQL, Bash, Docker, and other technologies based on the topic.' },
    { question: 'How often is content updated?', answer: 'Critical updates (security patches, breaking API changes) are applied within 48 hours. Routine reviews happen every 3-6 months for all published resources.' },
  ]),
];
---

<BaseLayout
  title="About StackPractices"
  description="Learn about StackPractices, a practical developer knowledge base for software engineers."
  path="/about"
  keywords={['about', 'stackpractices', 'developer knowledge base']}
  jsonLd={jsonLd}
>
  <div class="brand-accent"></div>

  <!-- Header section -->
  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
        <a href="/" class="font-medium text-brand-600 hover:text-brand-700 hover:underline">Home</a>
        <span class="mx-2 text-slate-400">/</span>
        <span class="font-medium text-slate-800">About</span>
      </nav>
      <h1 class="mt-4 text-3xl font-bold text-slate-900">About StackPractices</h1>
      <p class="mt-2 max-w-2xl text-lg text-slate-600">
        A practical knowledge base for developers who want to copy, run, and ship faster.
      </p>
    </div>
  </header>

  <!-- Mission -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-lg leading-relaxed text-slate-700">
          StackPractices is a practical developer knowledge base built for software engineers who want
          reusable code recipes, design patterns, and documentation templates across
          <strong>Python, Java, JavaScript, SQL, and more</strong>.
        </p>
        <p class="mt-4 leading-relaxed text-slate-600">
          Every resource is designed to be immediately useful: copy the code, adapt it to your project,
          and ship faster. We prioritize real-world examples over abstract theory, and we cover multiple
          languages so you can find the solution in the stack you are using today.
        </p>
      </div>
    </div>
  </section>

  <!-- Feature cards -->
  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900">What You Will Find</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-lg">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon name="alert-triangle" width="20" height="20" aria-hidden="true" />
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900">Recipes</h3>
          <p class="mt-1 text-sm text-slate-600">
            Short, actionable solutions to common development problems. Copy, paste, and adapt in minutes.
          </p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-lg">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon name="grid" width="20" height="20" aria-hidden="true" />
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900">Patterns</h3>
          <p class="mt-1 text-sm text-slate-600">
            Design and architecture patterns with practical implementations you can use right away.
          </p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-lg">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon name="file-text" width="20" height="20" aria-hidden="true" />
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900">Documentation</h3>
          <p class="mt-1 text-sm text-slate-600">
            Reusable templates for READMEs, API docs, runbooks, and other engineering artifacts.
          </p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-lg">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon name="book-open" width="20" height="20" aria-hidden="true" />
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900">Guides</h3>
          <p class="mt-1 text-sm text-slate-600">
            Long-form content that connects recipes and patterns into cohesive, real-world workflows.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">Our Approach</h2>
          <div class="mt-6 space-y-4 text-slate-700">
            <p>
              We believe the best documentation is the one you can <strong>copy, run, and adapt in minutes</strong>.
              Every article includes code in multiple languages, clear explanations, and a FAQ section for quick
              reference.
            </p>
            <p>
              Content is <strong>bilingual (English and Spanish)</strong> to serve the broadest possible audience.
              No paywalls, no subscriptions — just practical knowledge you can use today.
            </p>
          </div>
        </div>

        <div class="rounded-xl border border-slate-200 bg-slate-50 p-6">
          <h3 class="text-lg font-semibold text-slate-900">Built With</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm font-medium text-slate-700">Astro</span>
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm font-medium text-slate-700">Tailwind CSS</span>
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm font-medium text-slate-700">Pagefind</span>
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm font-medium text-slate-700">TypeScript</span>
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm font-medium text-slate-700">GitHub Pages</span>
          </div>
          <p class="mt-4 text-sm text-slate-600">
            Open source and free. The entire site is static — no backend, no database, no tracking beyond
            anonymous analytics (with your consent).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Author -->
  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center text-2xl font-bold text-slate-900">Behind the Project</h2>
        <div class="mt-8 flex flex-col items-center gap-6 sm:flex-row sm:items-start">
          <img
            src="/mathias-avatar.png"
            alt={PRIMARY_AUTHOR.name}
            class="h-32 w-32 shrink-0 rounded-full object-cover ring-2 ring-brand-200"
            loading="lazy"
          />
          <div class="text-center sm:text-left">
            <h3 class="text-lg font-semibold text-slate-900">{PRIMARY_AUTHOR.name}</h3>
            <p class="mt-2 text-slate-600">
              {PRIMARY_AUTHOR.bio} StackPractices is a personal project born from the belief
              that great documentation should be copy-paste ready. Learn more at
              <a href={PRIMARY_AUTHOR.url} target="_blank" rel="noopener noreferrer" class="text-brand-600 hover:underline">{PRIMARY_AUTHOR.url.replace(/^https?:\/\//, '')}</a>.
            </p>
            <div class="mt-4 flex flex-wrap justify-center gap-3 sm:justify-start">
              <a href={PRIMARY_AUTHOR.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-slate-700 ring-1 ring-slate-200 hover:text-brand-600 hover:ring-brand-300">
                <Icon name="globe" class="h-4 w-4" aria-hidden="true" />
                Website
              </a>
              <a href={PRIMARY_AUTHOR.sameAs[0]} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-slate-700 ring-1 ring-slate-200 hover:text-brand-600 hover:ring-brand-300">
                <Icon name="github" class="h-4 w-4" aria-hidden="true" />
                GitHub
              </a>
              <a href={PRIMARY_AUTHOR.sameAs[1]} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-slate-700 ring-1 ring-slate-200 hover:text-brand-600 hover:ring-brand-300">
                <Icon name="linkedin" class="h-4 w-4" aria-hidden="true" />
                LinkedIn
              </a>
              <a href={`mailto:${PRIMARY_AUTHOR.email}`} class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-slate-700 ring-1 ring-slate-200 hover:text-brand-600 hover:ring-brand-300">
                <Icon name="mail" class="h-4 w-4" aria-hidden="true" />
                Email
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Funding -->
  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-2xl font-bold text-slate-900">How We Keep This Going</h2>
        <p class="mt-3 text-slate-600">
          StackPractices is free to use. We sustain the project through a combination of advertising,
          affiliate partnerships, and community support.
        </p>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon name="info" width="20" height="20" aria-hidden="true" />
          </div>
          <h3 class="mt-4 text-base font-semibold text-slate-900">Advertising</h3>
          <p class="mt-1 text-sm text-slate-600">
            Relevant, non-intrusive ads help cover hosting and content creation costs.
          </p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon name="alert-triangle" width="20" height="20" aria-hidden="true" />
          </div>
          <h3 class="mt-4 text-base font-semibold text-slate-900">Affiliate Links</h3>
          <p class="mt-1 text-sm text-slate-600">
            Some pages include affiliate links to tools we genuinely recommend.
          </p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon name="heart" width="20" height="20" aria-hidden="true" />
          </div>
          <h3 class="mt-4 text-base font-semibold text-slate-900">Donations</h3>
          <p class="mt-1 text-sm text-slate-600">
            Community contributions through Ko-fi keep the content free and growing.
          </p>
        </div>
      </div>
      <p class="mt-8 text-center text-sm text-slate-500">
        We only recommend products and services we believe are valuable to developers.
        For full details, see our <a href="/affiliate-disclosure/" class="text-brand-600 hover:underline">Affiliate Disclosure</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-slate-900">Frequently Asked Questions</h2>
        <div class="mt-6 space-y-4">
          <details class="group rounded-xl border border-slate-200 bg-white open:border-brand-300 open:shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-semibold text-slate-800 select-none">
              <span>What is StackPractices?</span>
              <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-slate-400 group-open:rotate-180 transition" aria-hidden="true" />
            </summary>
            <div class="px-5 pb-4 text-sm text-slate-600"><p>StackPractices is a practical developer knowledge base offering copy-paste code recipes, design patterns, and documentation templates for software engineers across Python, Java, JavaScript, SQL, and more.</p></div>
          </details>
          <details class="group rounded-xl border border-slate-200 bg-white open:border-brand-300 open:shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-semibold text-slate-800 select-none">
              <span>Who runs StackPractices?</span>
              <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-slate-400 group-open:rotate-180 transition" aria-hidden="true" />
            </summary>
            <div class="px-5 pb-4 text-sm text-slate-600"><p>StackPractices is curated by {PRIMARY_AUTHOR.name}, a {PRIMARY_AUTHOR.jobTitle} with 12+ years of experience building production systems across Python, JavaScript, React, and DevOps.</p></div>
          </details>
          <details class="group rounded-xl border border-slate-200 bg-white open:border-brand-300 open:shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-semibold text-slate-800 select-none">
              <span>Is the content free?</span>
              <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-slate-400 group-open:rotate-180 transition" aria-hidden="true" />
            </summary>
            <div class="px-5 pb-4 text-sm text-slate-600"><p>Yes. All content is free to use. No paywalls, no subscriptions. The project is sustained through advertising, affiliate partnerships, and community donations.</p></div>
          </details>
          <details class="group rounded-xl border border-slate-200 bg-white open:border-brand-300 open:shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-semibold text-slate-800 select-none">
              <span>What languages are covered?</span>
              <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-slate-400 group-open:rotate-180 transition" aria-hidden="true" />
            </summary>
            <div class="px-5 pb-4 text-sm text-slate-600"><p>Content is published in English and Spanish. Code examples cover Python, Java, JavaScript, TypeScript, SQL, Bash, Docker, and other technologies based on the topic.</p></div>
          </details>
          <details class="group rounded-xl border border-slate-200 bg-white open:border-brand-300 open:shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-semibold text-slate-800 select-none">
              <span>How often is content updated?</span>
              <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-slate-400 group-open:rotate-180 transition" aria-hidden="true" />
            </summary>
            <div class="px-5 pb-4 text-sm text-slate-600"><p>Critical updates (security patches, breaking API changes) are applied within 48 hours. Routine reviews happen every 3-6 months for all published resources.</p></div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- Donation -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-6 text-center">
        <h2 class="text-lg font-semibold text-slate-900">Support StackPractices</h2>
        <p class="mt-2 text-sm text-slate-600">
          If you find this project useful, consider buying us a coffee. Your support helps keep the content free and growing.
        </p>
        <a
          href="https://ko-fi.com/C6E4212B3X"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block transition hover:scale-105 hover:brightness-110"
        >
          <img
            src="/kofi3.png"
            alt="Buy Me a Coffee at ko-fi.com"
            class="block h-12"
            loading="lazy"
          />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
