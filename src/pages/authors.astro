---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { webPage, breadcrumbList, person } from '../lib/schema';
import { PRIMARY_AUTHOR } from '../data/authors';

const jsonLd = [
  {
    ...webPage({
      name: 'Authors',
      description: `Meet ${PRIMARY_AUTHOR.name}, the software engineer behind StackPractices — copy-paste code recipes, design patterns, and engineering docs.`,
      url: '/authors/',
      locale: 'en',
    }),
    datePublished: '2026-06-13',
  },
  person({
    name: PRIMARY_AUTHOR.name,
    url: PRIMARY_AUTHOR.url,
    image: PRIMARY_AUTHOR.image,
    description: PRIMARY_AUTHOR.description,
    jobTitle: PRIMARY_AUTHOR.jobTitle,
    sameAs: PRIMARY_AUTHOR.sameAs,
    knowsAbout: PRIMARY_AUTHOR.knowsAbout,
  }),
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Authors', url: '/authors/' },
  ]),
];
---

<BaseLayout
  title="Authors"
  description={`Meet the author behind StackPractices — ${PRIMARY_AUTHOR.name}, a ${PRIMARY_AUTHOR.jobTitle.toLowerCase()} building practical resources for developers.`}
  path="/authors/"
  keywords={['mathias paulenko', 'author', 'software engineer', 'stackpractices']}
  jsonLd={jsonLd}
>
  <div class="brand-accent"></div>

  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
        <a href="/" class="font-medium text-brand-600 hover:text-brand-700 hover:underline">Home</a>
        <span class="mx-2 text-slate-400">/</span>
        <span class="font-medium text-slate-800">Authors</span>
      </nav>
      <h1 class="mt-4 text-3xl font-bold text-slate-900">About the Author</h1>
      <p class="mt-2 max-w-2xl text-lg text-slate-600">
        The person behind StackPractices — building practical resources for developers.
      </p>
    </div>
  </header>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="mx-auto max-w-3xl">
        <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start">
          <img
            src="/mathias-avatar.png"
            alt={PRIMARY_AUTHOR.name}
            class="h-32 w-32 shrink-0 rounded-full object-cover ring-2 ring-brand-200"
            loading="lazy"
          />
          <div class="text-center sm:text-left">
            <h2 class="text-2xl font-bold text-slate-900">{PRIMARY_AUTHOR.name}</h2>
            <p class="mt-1 text-sm font-medium text-brand-600">{PRIMARY_AUTHOR.jobTitle}</p>
            <p class="mt-4 leading-relaxed text-slate-700">
              {PRIMARY_AUTHOR.bio}
            </p>
            <p class="mt-4 leading-relaxed text-slate-600">
              StackPractices is my personal project, born from a simple belief:
              <strong>great documentation should be copy-paste ready</strong>. Every recipe, pattern,
              and guide on this site is designed to save you time and help you ship faster.
            </p>
            <div class="mt-6 flex flex-wrap justify-center gap-3 sm:justify-start">
              <a href={PRIMARY_AUTHOR.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-slate-700 ring-1 ring-slate-200 hover:text-brand-600 hover:ring-brand-300">
                <Icon name="globe" class="h-4 w-4" aria-hidden="true" />
                Website
              </a>
              <a href={PRIMARY_AUTHOR.sameAs[0]} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-slate-700 ring-1 ring-slate-200 hover:text-brand-600 hover:ring-brand-300">
                <Icon name="github" class="h-4 w-4" aria-hidden="true" />
                GitHub
              </a>
              <a href={PRIMARY_AUTHOR.sameAs[1]} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-slate-700 ring-1 ring-slate-200 hover:text-brand-600 hover:ring-brand-300">
                <Icon name="linkedin" class="h-4 w-4" aria-hidden="true" />
                LinkedIn
              </a>
              <a href={`mailto:${PRIMARY_AUTHOR.email}`} class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-slate-700 ring-1 ring-slate-200 hover:text-brand-600 hover:ring-brand-300">
                <Icon name="mail" class="h-4 w-4" aria-hidden="true" />
                Email
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon name="user" width="20" height="20" aria-hidden="true" />
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900">Peer Reviewed</h3>
          <p class="mt-1 text-sm text-slate-600">
            Every resource is reviewed by multiple engineers before publication.
          </p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon name="edit" width="20" height="20" aria-hidden="true" />
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900">Tested Code</h3>
          <p class="mt-1 text-sm text-slate-600">
            Code examples are run and validated in real development environments.
          </p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon name="history" width="20" height="20" aria-hidden="true" />
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900">Regularly Updated</h3>
          <p class="mt-1 text-sm text-slate-600">
            Content is kept current with the latest language versions and best practices.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-slate-900">Our Editorial Process</h2>
        <ol class="mt-6 space-y-4 text-slate-700">
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">1</span>
            <span><strong>Research</strong> — Identify real-world problems developers face daily.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">2</span>
            <span><strong>Draft</strong> — Write clear explanations with runnable code examples.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">3</span>
            <span><strong>Review</strong> — Technical review by domain experts for accuracy and completeness.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">4</span>
            <span><strong>Test</strong> — Run code in multiple environments to verify correctness.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">5</span>
            <span><strong>Publish &amp; Maintain</strong> — Release and update as technologies evolve.</span>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-slate-900">Get in Touch</h2>
        <p class="mt-4 text-slate-600">
          Have feedback, corrections, or suggestions? I would love to hear from you.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/contact/" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
            Contact
          </a>
          <a href="/" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-brand-400 hover:text-brand-700">
            Browse Recipes
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
