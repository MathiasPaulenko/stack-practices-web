---
import { getCollection } from 'astro:content';
import ListingPage from '../../../components/ListingPage.astro';
import { isSpanish } from '../../../lib/content';

const recipes = await getCollection('recipes', ({ id, data }) => isSpanish(id) && !data.draft);
const entries = recipes.map((r) => ({
  title: r.data.title,
  description: r.data.description,
  href: `/es/recipes/${r.data.slug}/`,
  difficulty: r.data.difficulty,
  tags: r.data.tags,
}));
---

<ListingPage
  heading="Recetas"
  description="Recetas de código prácticas listas para copiar en Python, JavaScript, Java, SQL y más. Soluciones probadas para problemas reales de desarrollo."
  path="/recipes/"
  locale="es"
  entries={entries}
  keywords={['recetas de código', 'cómo', 'ejemplos de programación']}
  contentType="recipes"
  jsonEndpoint="/es/recipes/index.json"
  initialLimit={20}
/>
