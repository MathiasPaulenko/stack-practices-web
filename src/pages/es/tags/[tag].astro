---
import { buildTagIndex, MIN_TAG_RESOURCES } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/ContentCard.astro';
import { webPage, breadcrumbList } from '../../../lib/schema';
import { tagIntros } from '../../../data/tag-intros';

const PAGE_SIZE = 20;

export async function getStaticPaths() {
  const tagIndex = await buildTagIndex('es');
  return Array.from(tagIndex.entries())
    .filter(([, items]) => items.length >= MIN_TAG_RESOURCES)
    .map(([tag]) => ({
      params: { tag },
      props: { tag },
    }));
}

const { tag } = Astro.props;
const tagIndex = await buildTagIndex('es');
const items = tagIndex.get(tag) ?? [];
const enTagIndex = await buildTagIndex('en');
const hasEnVersion = enTagIndex.has(tag);

const heading = `Etiqueta: ${tag}`;
const resourceCount = items.length;
const metaDescription = `Explora ${resourceCount} recursos de ${tag}: recetas, patrones, documentación y guías para ingeniería de software en producción.`;
const pageDescription = `Explora ${resourceCount} recursos prácticos de ingeniería de software etiquetados con "${tag}". Descubre recetas de código, patrones de diseño, plantillas de documentación y guías detalladas para ayudarte a construir, desplegar y mantener soluciones listas para producción con ${tag}.`;

const intro = tagIntros[tag]?.es;

const jsonLd = [
  webPage({ name: heading, description: metaDescription, url: `/es/tags/${tag}`, locale: 'es' }),
  breadcrumbList([
    { name: 'Inicio', url: '/es/' },
    { name: 'Etiquetas', url: '/es/tags/' },
    { name: tag, url: `/es/tags/${tag}/` },
  ]),
];

const initialItems = items.slice(0, PAGE_SIZE);
const hasMore = items.length > PAGE_SIZE;
---

<BaseLayout title={heading} description={metaDescription} path={`/tags/${tag}/`} locale="es" keywords={[tag, 'etiquetas', 'ingeniería de software']} jsonLd={jsonLd} hasAlternate={hasEnVersion} noindex={items.length < 3}>
  <section class="border-b border-slate-800 bg-slate-900">
    <div class="listing-container">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-400">
        <a href="/es/" class="font-medium text-brand-400 hover:text-brand-300">Inicio</a>
        <span class="mx-2 text-slate-600">/</span>
        <a href="/es/tags/" class="font-medium text-brand-400 hover:text-brand-300">Etiquetas</a>
        <span class="mx-2 text-slate-600">/</span>
        <span class="font-medium text-slate-300">{tag}</span>
      </nav>
      <h1 class="mt-4 text-3xl font-bold text-white">{heading}</h1>
      <p class="mt-2 max-w-2xl text-slate-300">{pageDescription}</p>
    </div>
  </section>

  {intro ? (
    <section class="listing-section">
      <div class="listing-container">
        <h2 class="listing-heading">{intro.heading}</h2>
        {intro.paragraphs.map((p) => (
          <p class="listing-intro">{p}</p>
        ))}
        <p class="listing-intro">
          Cada recurso incluye explicaciones claras, ejemplos de codigo y advertencias sobre errores comunes. Usa estos materiales para tomar decisiones informadas, evitar problemas en produccion y acelerar tu flujo de trabajo. Si estas empezando, lee primero los articulos marcados como principiante; si ya tienes experiencia, ve directo a los patrones avanzados y las guias de arquitectura.
        </p>
      </div>
    </section>
  ) : (
    <section class="listing-section">
      <div class="listing-container">
        <h2 class="listing-heading">{tag} — Recursos y Mejores Practicas</h2>
        <p class="listing-intro">
          {tag} es un tema recurrente en la ingenieria de software de produccion. Los recursos a continuacion recopilan recetas practicas, patrones de diseno, plantillas de documentacion y guias que muestran como usar {tag} de forma efectiva en sistemas reales.
        </p>
        <p class="listing-intro">
          Cada recurso incluye explicaciones claras, ejemplos de codigo y advertencias sobre errores comunes. Usa estos materiales para tomar decisiones informadas, evitar problemas en produccion y acelerar tu flujo de trabajo. Si estas empezando, lee primero los articulos marcados como principiante; si ya tienes experiencia, ve directo a los patrones avanzados y las guias de arquitectura.
        </p>
        <p class="listing-intro">
          Se agregan nuevos recursos regularmente, asi que guarda esta pagina y vuelve a consultarla para los ultimos patrones. Tambien puedes consultar etiquetas y temas relacionados para construir un modelo mental completo antes de implementar {tag} en tu propio stack. Comienza con la receta mas simple y avanza hacia la guia de arquitectura cuando estes listo para disenar sistemas mas grandes.
        </p>
      </div>
    </section>
  )}

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      {
        items.length > 0 ? (
          <>
            <div id="tag-grid" class="listing-grid">
              {initialItems.map((item) => (
                <ContentCard
                  title={item.title}
                  description={item.description}
                  href={item.href}
                  tags={item.tags}
                  locale="es"
                />
              ))}
            </div>
            {hasMore && (
              <div class="mt-8 text-center">
                <button
                  id="load-more"
                  type="button"
                  class="load-more-btn"
                >
                  Cargar más
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </button>
              </div>
            )}
          </>
        ) : (
          <div class="rounded-xl border border-dashed border-slate-300 bg-slate-100 p-12 text-center">
            <p class="text-slate-600">No se encontraron recursos con esta etiqueta.</p>
          </div>
        )
      }
    </div>
  </section>

  {hasMore && (
    <script is:inline define:vars={{ tag }}>
      (function () {
        const PAGE_SIZE = 20;
        const grid = document.getElementById('tag-grid');
        const loadMoreBtn = document.getElementById('load-more');
        if (!grid || !loadMoreBtn) return;

        function createCard(item) {
          const a = document.createElement('a');
          a.href = item.href;
          a.setAttribute('data-search', (item.title + ' ' + (item.description || '') + ' ' + (item.tags || []).join(' ')).toLowerCase());
          a.className = 'group flex h-full flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-400 hover:shadow-md';
          a.innerHTML = '<h3 class="text-lg font-semibold text-slate-900 group-hover:text-brand-600">' + item.title + '</h3>' +
            '<p class="mt-3 line-clamp-3 text-sm text-slate-600">' + (item.description || '') + '</p>';
          return a;
        }

        async function loadMore() {
          loadMoreBtn.disabled = true;
          loadMoreBtn.textContent = 'Cargando...';

          try {
            const res = await fetch('/es/tags/' + encodeURIComponent(tag) + '.json');
            if (!res.ok) throw new Error('failed');
            const data = await res.json();
            const entries = data.entries || [];

            for (let i = PAGE_SIZE; i < entries.length; i++) {
              grid.appendChild(createCard(entries[i]));
            }

            loadMoreBtn.style.display = 'none';
          } catch (e) {
            loadMoreBtn.textContent = 'Error al cargar';
            loadMoreBtn.disabled = false;
          }
        }

        loadMoreBtn.addEventListener('click', loadMore);
      })();
    </script>
  )}
</BaseLayout>
