---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config/site';
import { webPage } from '../../lib/schema';
import { getCollection } from 'astro:content';
import { isSpanish, buildTagIndex } from '../../lib/content';

const [recipes, patterns, docs, guides] = await Promise.all([
  getCollection('recipes', ({ id }) => isSpanish(id)),
  getCollection('patterns', ({ id }) => isSpanish(id)),
  getCollection('docs', ({ id }) => isSpanish(id)),
  getCollection('guides', ({ id }) => isSpanish(id)),
]);

const recipesCount = recipes.length;
const patternsCount = patterns.length;
const docsCount = docs.length;
const guidesCount = guides.length;
const totalCount = recipesCount + patternsCount + docsCount + guidesCount;
const topics = new Set<string>();
for (const col of [recipes, patterns, docs, guides]) {
  for (const entry of col) {
    entry.data.topics.forEach((t: string) => topics.add(t));
  }
}
const topicsCount = topics.size;

const tagIndex = await buildTagIndex('es');
const popularTags = Array.from(tagIndex.entries())
  .map(([tag, items]) => ({ tag, count: items.length }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))
  .slice(0, 16);

const contentTypes = [
  { slug: 'recipes', label: 'Recetas', description: 'Soluciones prácticas a problemas reales de desarrollo.' },
  { slug: 'patterns', label: 'Patrones', description: 'Patrones de diseño y arquitectura con ejemplos reales.' },
  { slug: 'docs', label: 'Documentación', description: 'Plantillas reutilizables de documentación técnica.' },
  { slug: 'guides', label: 'Guías', description: 'Contenido extenso que conecta recetas y patrones.' },
];

const description = 'Base de conocimiento práctica para ingenieros de software: recetas de código, patrones de diseño y documentación técnica reutilizable.';

const jsonLd = [
  webPage({ name: SITE.title, description, url: '/es', locale: 'es' }),
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    inLanguage: 'es',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${SITE.url}/es/search?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
];

const latestRecipes = [...recipes]
  .sort((a, b) => (b.data.lastUpdated?.getTime() || 0) - (a.data.lastUpdated?.getTime() || 0))
  .slice(0, 3);

const latestGuides = [...guides]
  .sort((a, b) => (b.data.lastUpdated?.getTime() || 0) - (a.data.lastUpdated?.getTime() || 0))
  .slice(0, 3);
---

<BaseLayout
  title="StackPractices — Recetas de Código, Patrones y Documentación"
  description={description}
  path="/"
  locale="es"
  keywords={['recetas de código', 'patrones de diseño', 'ingeniería de software']}
  jsonLd={jsonLd}
>
  <section class="home-hero hero-animated-bg bg-slate-900">
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-dot" aria-hidden="true"></span>
    <span class="hero-code-symbol" aria-hidden="true">{ }</span>
    <span class="hero-code-symbol" aria-hidden="true">&lt;/&gt;</span>
    <span class="hero-code-symbol" aria-hidden="true">//</span>
    <span class="hero-code-symbol" aria-hidden="true">[ ]</span>
    <span class="hero-code-symbol" aria-hidden="true">&&</span>
    <span class="hero-code-symbol" aria-hidden="true">;;</span>
    <div class="home-hero__inner">
      <h1 class="home-hero__title">
        Conocimiento práctico de ingeniería de software, listo para reutilizar
      </h1>
      <p class="home-hero__desc">
        Encuentra recetas de código reales, patrones de diseño y documentación reutilizable
        en Python, Java, JavaScript, SQL y más.
      </p>
      <div class="home-hero__stats home-hero-stats">
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{totalCount}</div>
          <div class="home-hero-stat__label">Total</div>
        </div>
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{recipesCount}</div>
          <div class="home-hero-stat__label">Recetas</div>
        </div>
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{patternsCount}</div>
          <div class="home-hero-stat__label">Patrones</div>
        </div>
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{docsCount}</div>
          <div class="home-hero-stat__label">Documentación</div>
        </div>
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{guidesCount}</div>
          <div class="home-hero-stat__label">Guías</div>
        </div>
        <div class="home-hero-stat">
          <div class="home-hero-stat__value">{topicsCount}</div>
          <div class="home-hero-stat__label">Temas</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Search -->
  <section class="home-search-section">
    <div class="home-search-inner">
      <form action="/es/search/" method="get" class="home-search-form">
        <Icon name="search" class="home-search-icon" aria-hidden="true" />
        <input
          type="search"
          name="q"
          placeholder="Buscar recetas, patrones, documentación y guías..."
          aria-label="Buscar recetas, patrones, documentación y guías"
          class="home-search-input"
        />
        <button
          type="submit"
          class="home-search-btn"
        >
          Buscar
        </button>
      </form>
      <p class="home-search-hint">
        Prueba: <a href="/es/search/?q=python">python</a>,
        <a href="/es/search/?q=api">api</a>,
        <a href="/es/search/?q=docker">docker</a>,
        <a href="/es/search/?q=testing">testing</a>
      </p>
    </div>
  </section>

  <!-- Why StackPractices -->
  <section class="home-why-section">
    <div class="home-section__inner">
      <div class="home-why-header">
        <h2 class="home-why-header__title">¿Por qué StackPractices?</h2>
        <p class="home-why-header__desc">Hecho para desarrolladores que valoran la velocidad, la claridad y el conocimiento reutilizable.</p>
      </div>
      <div class="home-why-grid">
        <div class="home-why-item">
          <span class="home-why-item__icon">
            <Icon name="plus-square" class="h-6 w-6" aria-hidden="true" />
          </span>
          <h3 class="home-why-item__title">Listo para copiar</h3>
          <p class="home-why-item__desc">Código que puedes copiar y ejecutar en tu proyecto inmediatamente.</p>
        </div>
        <div class="home-why-item">
          <span class="home-why-item__icon">
            <Icon name="menu-lines" class="h-6 w-6" aria-hidden="true" />
          </span>
          <h3 class="home-why-item__title">Multi-lenguaje</h3>
          <p class="home-why-item__desc">Ejemplos en Python, Java, JavaScript, TypeScript, SQL, Bash y más.</p>
        </div>
        <div class="home-why-item">
          <span class="home-why-item__icon">
            <Icon name="users" class="h-6 w-6" aria-hidden="true" />
          </span>
          <h3 class="home-why-item__title">Impulsado por la comunidad</h3>
          <p class="home-why-item__desc">Base de conocimiento abierta basada en desafíos reales de ingeniería.</p>
        </div>
        <div class="home-why-item">
          <span class="home-why-item__icon">
            <Icon name="file-text" class="h-6 w-6" aria-hidden="true" />
          </span>
          <h3 class="home-why-item__title">Documentación estructurada</h3>
          <p class="home-why-item__desc">Plantillas y guías consistentes para documentación mantenible.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Browse by Type -->
  <section class="home-section home-section--white">
    <div class="home-section__inner">
      <h2 class="home-section__heading">Explorar por tipo</h2>
      <p class="home-section__subheading">Elige el tipo de recurso que necesitas para tu proyecto.</p>
      <div class="home-type-grid">
        {contentTypes.map((type) => {
          const count = type.slug === 'recipes' ? recipesCount : type.slug === 'patterns' ? patternsCount : type.slug === 'docs' ? docsCount : guidesCount;
          const icon = type.slug === 'recipes' ? (
            <Icon name="timer" class="h-5 w-5" aria-hidden="true" />
          ) : type.slug === 'patterns' ? (
            <Icon name="grid" class="h-5 w-5" aria-hidden="true" />
          ) : type.slug === 'docs' ? (
            <Icon name="file-text" class="h-5 w-5" aria-hidden="true" />
          ) : (
            <Icon name="compass" class="h-5 w-5" aria-hidden="true" />
          );
          return (
            <a href={`/es/${type.slug}/`} class="home-type-card">
              <div class="home-type-card__header">
                <span class="home-type-card__icon">{icon}</span>
                <div class="home-type-card__body">
                  <div class="home-type-card__title-row">
                    <h3 class="home-type-card__title">{type.label}</h3>
                    <span class="home-type-card__count">{count}</span>
                  </div>
                  <p class="home-type-card__desc">{type.description}</p>
                </div>
              </div>
              <div class="home-type-card__footer">
                Explorar
                <Icon name="chevron-right" class="ml-1.5 h-4 w-4 transition group-hover:translate-x-1" aria-hidden="true" />
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Browse by Tag -->
  <section class="home-section home-section--slate">
    <div class="home-section__inner">
      <div class="home-section__header">
        <div>
          <h2 class="home-section__heading">Explorar por etiqueta</h2>
          <p class="home-section__subheading">Acceso rápido a los temas más populares en todo el contenido.</p>
        </div>
        <a href="/es/tags/" class="home-view-all">
          Ver todas las etiquetas
          <Icon name="chevron-right" class="ml-1.5 h-4 w-4" aria-hidden="true" />
        </a>
      </div>
      <div class="home-tag-cloud">
        {popularTags.map(({ tag, count }) => (
          <a href={`/es/tags/${tag}/`} class="home-tag-pill">
            <span class="home-tag-pill__count">{count}</span>
            {tag}
          </a>
        ))}
      </div>
      <a href="/es/tags/" class="home-view-all home-view-all--mobile">
        Ver todas las etiquetas
        <Icon name="chevron-right" class="ml-1.5 h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- Explore Topics CTA -->
  <section class="home-section home-section--white">
    <div class="home-section__inner">
      <div class="home-cta-box">
        <h2 class="home-cta-box__title">Explorar por Tema y Tecnología</h2>
        <p class="home-cta-box__desc">
          Navega todos los recursos organizados por conceptos de ingeniería de software como API Design,
          Autenticación y Testing — o por tu lenguaje de programación favorito.
        </p>
        <a href="/es/topics/" class="home-cta-btn">
          Explorar temas
          <Icon name="chevron-right" class="ml-2 h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Recipes -->
  <section class="home-section home-section--slate">
    <div class="home-section__inner">
      <div class="home-section__header">
        <div>
          <h2 class="home-section__heading">Últimas recetas</h2>
          <p class="home-section__subheading">Nuevas soluciones de código añadidas a la base de conocimiento.</p>
        </div>
        <a href="/es/recipes/" class="home-view-all">
          Ver todas
          <Icon name="chevron-right" class="ml-1.5 h-4 w-4" aria-hidden="true" />
        </a>
      </div>
      <div class="home-content-grid">
        {latestRecipes.map((recipe) => (
          <a href={`/es/recipes/${recipe.data.slug}/`} class="home-content-card">
            <div class="home-content-card__meta">
              <span class="home-content-card__difficulty">{recipe.data.difficulty}</span>
              <span class="home-content-card__topic">{recipe.data.topics[0]?.replace(/-/g, ' ')}</span>
            </div>
            <h3 class="home-content-card__title">{recipe.data.title}</h3>
            <p class="home-content-card__desc">{recipe.data.description}</p>
            <div class="home-content-card__tags">
              {recipe.data.tags.slice(0, 3).map((tag: string) => (
                <span class="home-content-card__tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
      <a href="/es/recipes/" class="home-view-all home-view-all--mobile">Ver todas las recetas →</a>
    </div>
  </section>

  <!-- Latest Guides -->
  <section class="home-section home-section--white">
    <div class="home-section__inner">
      <div class="home-section__header">
        <div>
          <h2 class="home-section__heading">Últimas guías</h2>
          <p class="home-section__subheading">Guías de ingeniería detalladas que conectan recetas y patrones.</p>
        </div>
        <a href="/es/guides/" class="home-view-all">
          Ver todas
          <Icon name="chevron-right" class="ml-1.5 h-4 w-4" aria-hidden="true" />
        </a>
      </div>
      <div class="home-content-grid">
        {latestGuides.map((guide) => (
          <a href={`/es/guides/${guide.data.slug}/`} class="home-content-card">
            <div class="home-content-card__meta">
              <span class="home-content-card__difficulty">{guide.data.difficulty}</span>
              <span class="home-content-card__topic">{guide.data.topics[0]?.replace(/-/g, ' ')}</span>
            </div>
            <h3 class="home-content-card__title">{guide.data.title}</h3>
            <p class="home-content-card__desc">{guide.data.description}</p>
            <div class="home-content-card__tags">
              {guide.data.tags.slice(0, 3).map((tag: string) => (
                <span class="home-content-card__tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
      <a href="/es/guides/" class="home-view-all home-view-all--mobile">Ver todas las guías →</a>
    </div>
  </section>
</BaseLayout>
