---
import { getCollection, render } from 'astro:content';
import RecipeArticle from '../../../components/RecipeArticle.astro';
import { buildResourceIndex, resolveRelated, extractFaqs, isSpanish, getPublicTagSet } from '../../../lib/content';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ id }) => isSpanish(id));
  return guides.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const d = entry.data;
const index = await buildResourceIndex('es');
const related = resolveRelated(d.relatedResources, index, 'es');
const faqs = extractFaqs(entry.body ?? '');
const publicTagSet = await getPublicTagSet('es');
const publicTags = d.tags.filter((tag) => publicTagSet.has(tag));
---

<RecipeArticle
  title={d.title}
  description={d.description}
  metaDescription={d.metaDescription}
  keywords={d.seo.keywords}
  difficulty={d.difficulty}
  tags={publicTags}
  topics={d.topics}
  lastUpdated={d.lastUpdated}
  publishedAt={d.publishedAt}
  author={d.author}
  path={`/guides/${d.slug}/`}
  locale="es"
  listingHref="/es/guides/"
  listingLabel="Guías"
  related={related}
  faqs={faqs}
  relatedLabel="Recursos Relacionados"
  contentType="guides"
>
  <Content />
</RecipeArticle>
